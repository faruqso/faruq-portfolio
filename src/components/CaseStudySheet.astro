---
import CaseStudy from './CaseStudy.astro';
import { caseStudies } from '../data/caseStudies';
import { projects } from '../data/site';

const entries = caseStudies.map((study, index) => {
	const project = projects.find((p) => p.slug === study.slug);
	if (!project) throw new Error(`No project card for case study "${study.slug}"`);
	return { study, project, next: caseStudies[(index + 1) % caseStudies.length] };
});
---

<dialog class="sheet" data-sheet aria-label="Case study">
	<div class="sheet__scrim" data-sheet-scrim></div>
	<div class="sheet__panel" data-sheet-panel>
		<div class="sheet__bar" data-sheet-handle>
			<span class="sheet__grabber" aria-hidden="true"></span>
			<button type="button" class="sheet__close" data-sheet-close aria-label="Close case study">
				<svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
					<path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
				</svg>
			</button>
		</div>
		<div class="sheet__scroller" data-sheet-scroller tabindex="-1">
			{entries.map((entry) => <CaseStudy {...entry} />)}
		</div>
	</div>
</dialog>

<style>
	.sheet {
		position: fixed;
		inset: 0;
		width: 100%;
		max-width: none;
		height: 100%;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
		overflow: hidden;
		color: var(--color-text);
	}

	.sheet::backdrop {
		background: transparent;
	}

	.sheet__scrim {
		position: absolute;
		inset: 0;
		background: rgba(24, 26, 27, 0.45);
		opacity: 0;
		transition: opacity 300ms ease;
	}

	/* Edge to edge on every breakpoint; small gap at top so the page stays visible behind. */
	.sheet__panel {
		position: absolute;
		inset: auto 0 0 0;
		height: calc(100% - 24px);
		display: flex;
		flex-direction: column;
		border-radius: 20px 20px 0 0;
		background: var(--color-bg);
		box-shadow: 0 -12px 40px rgba(24, 26, 27, 0.12);
		overflow: hidden;
		transform: translate3d(0, 100%, 0);
		transition: transform 300ms cubic-bezier(0.4, 0, 1, 1);
		will-change: transform;
	}

	.sheet.is-open .sheet__scrim {
		opacity: 1;
	}

	.sheet.is-open .sheet__panel {
		transform: translate3d(0, 0, 0);
		/* iOS-style sheet curve */
		transition: transform 500ms cubic-bezier(0.32, 0.72, 0, 1);
	}

	.sheet.is-dragging .sheet__panel,
	.sheet.is-dragging .sheet__scrim {
		transition: none;
	}

	.sheet__bar {
		position: relative;
		flex-shrink: 0;
		height: 44px;
		touch-action: none;
		cursor: grab;
	}

	.sheet.is-dragging .sheet__bar {
		cursor: grabbing;
	}

	.sheet__grabber {
		position: absolute;
		left: 50%;
		top: 10px;
		width: 40px;
		height: 5px;
		border-radius: 999px;
		background: var(--color-border);
		transform: translateX(-50%);
	}

	.sheet__close {
		position: absolute;
		right: 12px;
		top: 6px;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		padding: 0;
		border: 0;
		border-radius: 999px;
		background: var(--color-bg-subtle);
		color: var(--color-text);
		cursor: pointer;
		transition: background-color var(--duration-fast) var(--ease-out);
	}

	@media (hover: hover) {
		.sheet__close:hover {
			background: var(--color-border);
		}
	}

	.sheet__scroller {
		flex: 1 1 auto;
		overflow-y: auto;
		overscroll-behavior: contain;
		-webkit-overflow-scrolling: touch;
		outline: none;
	}

	@media (max-width: 47.99rem) {
		.sheet__panel {
			height: calc(100% - 12px);
			border-radius: 16px 16px 0 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.sheet__panel,
		.sheet.is-open .sheet__panel {
			transition: none;
		}
	}
</style>

<script>
	const dialog = document.querySelector<HTMLDialogElement>('[data-sheet]');

	if (dialog) {
		const panel = dialog.querySelector<HTMLElement>('[data-sheet-panel]')!;
		const scrim = dialog.querySelector<HTMLElement>('[data-sheet-scrim]')!;
		const scroller = dialog.querySelector<HTMLElement>('[data-sheet-scroller]')!;
		const handle = dialog.querySelector<HTMLElement>('[data-sheet-handle]')!;
		const panels = [...dialog.querySelectorAll<HTMLElement>('[data-case-panel]')];
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

		let active: string | null = null;
		let pushedHistory = false;
		let afterClose: (() => void) | null = null;
		let closing = false;

		const hashFor = (slug: string) => `#case-${slug}`;
		const slugFromHash = () => {
			const match = location.hash.match(/^#case-(.+)$/);
			return match && panels.some((p) => p.dataset.casePanel === match[1]) ? match[1] : null;
		};

		const show = (slug: string) => {
			panels.forEach((p) => (p.hidden = p.dataset.casePanel !== slug));
			const current = panels.find((p) => p.dataset.casePanel === slug);
			dialog.setAttribute('aria-label', `Case study: ${current?.querySelector('h2')?.textContent ?? ''}`);
			// Eager-load the preview inside the sheet.
			current?.querySelectorAll<HTMLImageElement>('img[loading="lazy"]').forEach((img) => (img.loading = 'eager'));
			scroller.scrollTop = 0;
			active = slug;
		};

		const lockPage = (lock: boolean) => {
			const root = document.documentElement;
			if (lock) {
				const gap = window.innerWidth - root.clientWidth;
				root.style.overflow = 'hidden';
				if (gap > 0) root.style.paddingRight = `${gap}px`;
			} else {
				root.style.overflow = '';
				root.style.paddingRight = '';
			}
		};

		const open = (slug: string, { push = true } = {}) => {
			if (dialog.open) {
				// Already open: swap content (e.g. "Next project").
				show(slug);
				history.replaceState(history.state, '', hashFor(slug));
				scroller.focus({ preventScroll: true });
				return;
			}
			show(slug);
			if (push) {
				history.pushState({ caseStudy: slug }, '', hashFor(slug));
				pushedHistory = true;
			}
			lockPage(true);
			dialog.showModal();
			scroller.focus({ preventScroll: true });
			panel.style.transform = '';
			scrim.style.opacity = '';
			// Next frame so the closed state is painted first, then animate in.
			requestAnimationFrame(() => requestAnimationFrame(() => dialog.classList.add('is-open')));
		};

		const finishClose = () => {
			dialog.classList.remove('is-open', 'is-dragging');
			dialog.close();
			lockPage(false);
			panel.style.transform = '';
			scrim.style.opacity = '';
			active = null;
			closing = false;
			const done = afterClose;
			afterClose = null;
			done?.();
		};

		// Animate out; history is cleaned up by the caller.
		const animateClose = () => {
			if (!dialog.open || closing) return;
			closing = true;
			dialog.classList.remove('is-dragging');
			panel.style.transform = '';
			scrim.style.opacity = '';
			dialog.classList.remove('is-open');
			if (reduceMotion.matches) return finishClose();
			let finished = false;
			const end = () => {
				if (finished) return;
				finished = true;
				panel.removeEventListener('transitionend', onEnd);
				finishClose();
			};
			const onEnd = (event: TransitionEvent) => {
				if (event.target === panel && event.propertyName === 'transform') end();
			};
			panel.addEventListener('transitionend', onEnd);
			window.setTimeout(end, 450);
		};

		// User-initiated close: step back through history if we added an entry.
		const requestClose = (then?: () => void) => {
			if (then) afterClose = then;
			if (pushedHistory && history.state?.caseStudy) {
				pushedHistory = false;
				history.back(); // popstate → animateClose
			} else {
				pushedHistory = false;
				history.replaceState(null, '', location.pathname + location.search);
				animateClose();
			}
		};

		window.addEventListener('popstate', () => {
			const slug = slugFromHash();
			if (slug) open(slug, { push: false });
			else if (dialog.open) {
				pushedHistory = false;
				animateClose();
			}
		});

		// Open from any [data-case-study] link on the page (cards, "Next project").
		document.addEventListener('click', (event) => {
			const trigger = (event.target as Element).closest<HTMLElement>('[data-case-study]');
			if (!trigger) return;
			event.preventDefault();
			open(trigger.dataset.caseStudy!);
		});

		dialog.addEventListener('click', (event) => {
			const target = event.target as Element;
			if (target === scrim || target === dialog) return requestClose();
			if (target.closest('[data-sheet-close]')) return requestClose();
			const cta = target.closest('[data-sheet-cta] a');
			if (cta) {
				event.preventDefault();
				const href = cta.getAttribute('href') ?? '#contact';
				requestClose(() => document.querySelector(href)?.scrollIntoView({ behavior: reduceMotion.matches ? 'auto' : 'smooth' }));
			}
		});

		// Esc: animate instead of the instant native close.
		dialog.addEventListener('cancel', (event) => {
			event.preventDefault();
			requestClose();
		});

		/* ---- Drag to dismiss ----
		 * Grab bar: always drags. Content: drags only when scrolled to the top and pulling down.
		 * The panel tracks the pointer 1:1; release past 25% of the height or with a downward
		 * flick closes, otherwise it springs back. */
		let startY = 0;
		let lastY = 0;
		let lastT = 0;
		let velocity = 0;
		let dragging = false;
		let pointerId: number | null = null;

		const setOffset = (dy: number) => {
			// Rubber-band when pulled above the resting position.
			const offset = dy < 0 ? -Math.sqrt(-dy) * 2 : dy;
			panel.style.transform = `translate3d(0, ${offset}px, 0)`;
			scrim.style.opacity = String(Math.max(0, 1 - Math.max(0, offset) / panel.offsetHeight));
		};

		const beginDrag = (y: number) => {
			dragging = true;
			startY = lastY = y;
			lastT = performance.now();
			velocity = 0;
			dialog.classList.add('is-dragging');
		};

		const moveDrag = (y: number) => {
			const now = performance.now();
			const dt = Math.max(1, now - lastT);
			velocity = 0.8 * ((y - lastY) / dt) + 0.2 * velocity;
			lastY = y;
			lastT = now;
			setOffset(y - startY);
		};

		const endDrag = () => {
			if (!dragging) return;
			dragging = false;
			pointerId = null;
			const dy = lastY - startY;
			dialog.classList.remove('is-dragging');
			if (dy > panel.offsetHeight * 0.25 || (velocity > 0.5 && dy > 10)) {
				requestClose();
			} else {
				panel.style.transform = '';
				scrim.style.opacity = '';
			}
		};

		handle.addEventListener('pointerdown', (event) => {
			if ((event.target as Element).closest('button')) return;
			pointerId = event.pointerId;
			handle.setPointerCapture(event.pointerId);
			beginDrag(event.clientY);
		});
		handle.addEventListener('pointermove', (event) => {
			if (dragging && event.pointerId === pointerId) moveDrag(event.clientY);
		});
		handle.addEventListener('pointerup', endDrag);
		handle.addEventListener('pointercancel', endDrag);

		// Touch on the content: hand off from scrolling to dragging at the top edge.
		let touchStartY = 0;
		let touchFromTop = false;
		scroller.addEventListener(
			'touchstart',
			(event) => {
				touchStartY = event.touches[0].clientY;
				touchFromTop = scroller.scrollTop <= 0;
			},
			{ passive: true },
		);
		scroller.addEventListener(
			'touchmove',
			(event) => {
				const y = event.touches[0].clientY;
				if (!dragging) {
					if (touchFromTop && scroller.scrollTop <= 0 && y - touchStartY > 6) beginDrag(y);
					else return;
				}
				event.preventDefault();
				moveDrag(y);
			},
			{ passive: false },
		);
		scroller.addEventListener('touchend', endDrag);
		scroller.addEventListener('touchcancel', endDrag);

		// Deep link: /#case-mightyocto opens the sheet on load.
		const initial = slugFromHash();
		if (initial) open(initial, { push: false });
	}
</script>
