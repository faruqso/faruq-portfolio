---
/**
 * Avatar that sits beside the wordmark and reveals a short "who I am" card.
 * ≥768px: card opens on hover (mouse) or keyboard focus; a click pins it open.
 * <768px: a tap opens the same content as a bottom action sheet.
 * The avatar sways slowly to hint that it does something. It pauses while hovered
 * or open and starts again once closed. Still under prefers-reduced-motion.
 */
import { about } from '../data/site';
import { audit } from '../data/leads';

const card = audit.about;
---

<div class="avatar" data-avatar>
	<button
		type="button"
		class="avatar__button"
		aria-label="About Faruq"
		aria-expanded="false"
		aria-controls="avatar-card"
		data-avatar-button
	>
		<span class="avatar__photo">
			<img src={about.photo} alt="" width="472" height="1080" />
		</span>
	</button>

	<div id="avatar-card" class="avatar__card" role="region" aria-label="About Faruq" data-avatar-card>
		<div class="bio">
			<p class="bio__name">{card.name}</p>
			<p class="bio__text">{card.text}</p>
			<ul class="bio__proof">
				{card.proof.map((item) => <li>{item}</li>)}
			</ul>
		</div>
	</div>

	<dialog class="avatar__sheet" aria-label="About Faruq" data-avatar-sheet>
		<div class="avatar__sheet-panel">
			<div class="avatar__sheet-head">
				<span class="avatar__photo avatar__photo--lg">
					<img src={about.photo} alt="" width="472" height="1080" />
				</span>
				<button type="button" class="avatar__close" aria-label="Close" data-avatar-close>
					<svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"
						><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
						></path></svg
					>
				</button>
			</div>
			<div class="bio">
				<p class="bio__name">{card.name}</p>
				<p class="bio__text">{card.text}</p>
				<ul class="bio__proof">
					{card.proof.map((item) => <li>{item}</li>)}
				</ul>
			</div>
		</div>
	</dialog>
</div>

<script>
	const root = document.querySelector<HTMLElement>('[data-avatar]');
	const button = root?.querySelector<HTMLButtonElement>('[data-avatar-button]');
	const sheet = root?.querySelector<HTMLDialogElement>('[data-avatar-sheet]');
	const useSheet = () => !window.matchMedia('(min-width: 48rem)').matches;

	const setPinned = (pinned: boolean) => {
		if (!root || !button) return;
		root.toggleAttribute('data-pinned', pinned);
		button.setAttribute('aria-expanded', String(pinned));
	};

	const closeSheet = () => {
		if (!sheet?.open || sheet.dataset.closing) return;
		let done = false;
		const finish = () => {
			if (done) return;
			done = true;
			sheet.close();
			delete sheet.dataset.closing;
			document.documentElement.classList.remove('sheet-open');
			root?.removeAttribute('data-sheet-active');
			button?.setAttribute('aria-expanded', 'false');
			button?.focus();
		};
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return finish();
		sheet.dataset.closing = 'true';
		sheet.querySelector('.avatar__sheet-panel')?.addEventListener('animationend', finish, { once: true });
		window.setTimeout(finish, 320);
	};

	button?.addEventListener('click', () => {
		if (useSheet()) {
			if (!sheet) return;
			root?.setAttribute('data-sheet-active', '');
			sheet.showModal();
			document.documentElement.classList.add('sheet-open');
			button.setAttribute('aria-expanded', 'true');
		} else {
			setPinned(!root?.hasAttribute('data-pinned'));
		}
	});

	document.addEventListener('click', (event) => {
		if (root?.hasAttribute('data-pinned') && !root.contains(event.target as Node)) setPinned(false);
	});
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && root?.hasAttribute('data-pinned')) {
			setPinned(false);
			button?.focus();
		}
	});

	sheet?.querySelector('[data-avatar-close]')?.addEventListener('click', closeSheet);
	sheet?.addEventListener('cancel', (event) => {
		event.preventDefault();
		closeSheet();
	});
	sheet?.addEventListener('click', (event) => {
		if (event.target === sheet) closeSheet();
	});
</script>

<style>
	.avatar {
		position: relative;
		display: inline-flex;
	}

	.avatar__button {
		display: block;
		padding: 0;
		border: 0;
		border-radius: 14px;
		background: none;
		cursor: pointer;
		transform-origin: 50% 90%;
		animation: sway 3.6s ease-in-out infinite;
	}

	/* Pause the sway while it's being looked at; it resumes once closed. */
	.avatar[data-pinned] .avatar__button,
	.avatar[data-sheet-active] .avatar__button,
	.avatar__button:hover,
	.avatar__button:focus-visible {
		animation: none;
	}

	.avatar__photo {
		transition:
			transform var(--duration-fast) var(--ease-out),
			box-shadow var(--duration-fast) var(--ease-out);
	}

	@media (min-width: 48rem) {
		.avatar__button:hover .avatar__photo {
			transform: scale(1.14);
			box-shadow:
				0 0 0 1px rgba(24, 26, 27, 0.08),
				0 6px 16px rgba(24, 26, 27, 0.16);
		}
	}

	.avatar[data-pinned] .avatar__photo {
		box-shadow: 0 0 0 2px var(--color-accent);
	}

	.avatar__button:focus-visible {
		outline: none;
		box-shadow: 0 0 0 3px var(--color-focus-ring);
	}

	.avatar__button:active .avatar__photo {
		transform: scale(0.94);
		transition-duration: var(--duration-instant);
	}

	/* Same crop as the footer avatar */
	.avatar__photo {
		position: relative;
		display: block;
		width: 40px;
		height: 40px;
		border-radius: 12px;
		overflow: hidden;
		box-shadow: 0 0 0 1px rgba(24, 26, 27, 0.08);
	}

	.avatar__photo img {
		position: absolute;
		left: 50%;
		top: -29px;
		width: 40px;
		height: 91px;
		max-width: none;
		transform: translateX(-50%);
		object-fit: cover;
	}

	.avatar__photo--lg {
		width: 64px;
		height: 64px;
		border-radius: var(--radius-lg);
	}

	.avatar__photo--lg img {
		top: -46px;
		width: 64px;
		height: 145px;
	}

	@keyframes sway {
		0%,
		100% {
			transform: rotate(0deg) translateY(0);
		}
		20% {
			transform: rotate(-5deg) translateY(-1px);
		}
		40% {
			transform: rotate(4deg) translateY(0);
		}
		55% {
			transform: rotate(-2deg) translateY(-1px);
		}
		70% {
			transform: rotate(0deg) translateY(0);
		}
	}

	/* ---------- Desktop hover card ---------- */
	.avatar__card {
		position: absolute;
		top: calc(100% + 12px);
		left: 0;
		z-index: 50;
		width: 22rem;
		padding: var(--space-5);
		border-radius: var(--radius-lg);
		background: var(--color-surface-solid);
		box-shadow:
			0 16px 40px rgba(24, 26, 27, 0.14),
			0 0 0 1px rgba(24, 26, 27, 0.06);
		opacity: 0;
		visibility: hidden;
		transform: translateY(-4px) scale(0.98);
		transform-origin: 20px 0;
		transition:
			opacity var(--duration-fast) var(--ease-out) 120ms,
			transform var(--duration-fast) var(--ease-out) 120ms,
			visibility 0s linear calc(var(--duration-fast) + 120ms);
	}

	/* Invisible bridge so the pointer can travel from avatar to card. */
	.avatar__card::before {
		content: '';
		position: absolute;
		inset: -12px 0 auto;
		height: 12px;
	}

	@media (min-width: 48rem) {
		.avatar:hover .avatar__card {
			opacity: 1;
			visibility: visible;
			transform: none;
			transition:
				opacity var(--duration-fast) var(--ease-out) 60ms,
				transform var(--duration-fast) var(--ease-out) 60ms,
				visibility 0s linear 60ms;
		}
	}

	@media (min-width: 48rem) {
		.avatar:has(.avatar__button:focus-visible) .avatar__card,
		.avatar[data-pinned] .avatar__card {
			opacity: 1;
			visibility: visible;
			transform: none;
			transition:
				opacity var(--duration-fast) var(--ease-out) 60ms,
				transform var(--duration-fast) var(--ease-out) 60ms,
				visibility 0s linear 60ms;
		}
	}

	@media (max-width: 47.99rem) {
		.avatar__card {
			display: none;
		}
	}

	.bio {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.bio__name {
		font-size: var(--text-body-lg);
		line-height: var(--leading-snug);
	}

	.bio__text {
		font-size: var(--text-small);
		line-height: var(--leading-body);
		color: var(--color-text-secondary);
	}

	.bio__proof {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin: var(--space-2) 0 0;
		padding: 0;
		list-style: none;
	}

	.bio__proof li {
		padding: 4px 10px;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-pill);
		background: var(--color-bg);
		font-size: var(--text-caption);
		line-height: 1.5;
	}

	/* ---------- Mobile action sheet ---------- */
	.avatar__sheet {
		width: 100%;
		max-width: none;
		margin: auto 0 0;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--color-text);
		overflow: visible;
	}

	.avatar__sheet::backdrop {
		background: rgba(24, 26, 27, 0.4);
		animation: fade-in var(--duration-standard) var(--ease-out);
	}

	.avatar__sheet[data-closing]::backdrop {
		animation: fade-out var(--duration-fast) var(--ease-out) forwards;
	}

	.avatar__sheet-panel {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		padding: var(--space-5) var(--space-5) calc(var(--space-6) + env(safe-area-inset-bottom));
		border-radius: var(--radius-xl) var(--radius-xl) 0 0;
		background: var(--color-bg);
		animation: sheet-up 380ms var(--ease-out);
	}

	.avatar__sheet[data-closing] .avatar__sheet-panel {
		animation: sheet-down 240ms var(--ease-out) forwards;
	}

	.avatar__sheet-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
	}

	.avatar__close {
		display: grid;
		place-content: center;
		width: 40px;
		height: 40px;
		border: 0;
		border-radius: 50%;
		background: var(--color-bg-subtle);
		color: var(--color-text);
		cursor: pointer;
	}

	.avatar__close:active {
		transform: scale(0.94);
	}

	.avatar__sheet .bio__proof li {
		background: var(--color-surface-solid);
	}

	@keyframes sheet-up {
		from {
			transform: translateY(100%);
		}
	}

	@keyframes sheet-down {
		to {
			transform: translateY(100%);
		}
	}

	@keyframes fade-in {
		from {
			opacity: 0;
		}
	}

	@keyframes fade-out {
		to {
			opacity: 0;
		}
	}
</style>
