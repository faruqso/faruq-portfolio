---
import Button from './Button.astro';
import { clientLogos, hero, primaryCta, proof } from '../data/site';
---

<section class="hero" aria-labelledby="hero-heading">
	<div class="container">
		<div class="hero__main">
			<div class="hero__label-row">
				<p class="eyebrow">{hero.eyebrow}</p>
				<span class="clients" role="img" aria-label="Logos of businesses I’ve worked with">
					<span class="clients__chips">
						{
							clientLogos.map((logo) => (
								<span class="clients__chip">
									<img src={logo.src} alt="" width={logo.width} height={logo.height} />
								</span>
							))
						}
					</span>
					<span class="clients__more" aria-hidden="true"><i></i><i></i><i></i></span>
				</span>
			</div>
			<h1 id="hero-heading" class="hero__headline">
				{hero.headline}<span class="text-accent">{hero.headlineAccent}</span>
			</h1>
			<div class="hero__support">
				<p class="text-lead hero__description">{hero.description}</p>
				<div class="hero__actions">
					<Button href={primaryCta.href}>{primaryCta.label}</Button>
					<Button href={hero.secondaryCta.href} variant="secondary" class="hero__secondary">
						{hero.secondaryCta.label}
					</Button>
					<a class="hero__text-link" href={hero.secondaryCta.href}>
						{hero.secondaryCta.label} <span aria-hidden="true">↓</span>
					</a>
				</div>
			</div>
		</div>

		<dl class="proof">
			{
				proof.map((item) => (
					<div class="proof__item">
						<dt class="proof__label">{item.label}</dt>
						<dd class="proof__value">{item.value}</dd>
					</div>
				))
			}
		</dl>
	</div>
</section>

<style>
	.hero {
		padding-block: 88px var(--space-8);
	}

	.hero__main {
		display: flex;
		flex-direction: column;
		gap: 36px;
	}

	.hero__label-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-3) var(--space-5);
	}

	.clients {
		display: inline-flex;
		align-items: center;
		gap: var(--space-3);
	}

	.clients__chips {
		display: flex;
		align-items: center;
		height: 32px;
	}

	.clients__chip {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		margin-right: -8.4px;
		border: 0.7px solid var(--color-accent-soft);
		border-radius: var(--radius-pill);
		background: var(--color-surface-solid);
		overflow: hidden;
	}

	.clients__chip:last-child {
		margin-right: 0;
	}

	.clients__more {
		display: flex;
		gap: 1.4px;
	}

	.clients__more i {
		width: 4.2px;
		height: 4.2px;
		background: var(--color-accent);
	}

	.hero__headline {
		font-size: var(--text-hero);
		line-height: var(--leading-hero);
		letter-spacing: var(--tracking-hero);
	}

	.hero__support {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-5) 72px;
	}

	.hero__description {
		max-width: 650px;
		flex: 1 1 22rem;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
	}

	.hero__text-link {
		display: none;
	}

	.proof {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-8);
		margin: var(--space-8) 0 0;
		padding-top: 36px;
		border-top: 1px solid var(--color-border);
	}

	.proof__item {
		display: flex;
		flex-direction: column-reverse;
		justify-content: flex-end;
		gap: 6px;
	}

	.proof__value {
		margin: 0;
		font-size: var(--text-stat);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-stat);
	}

	.proof__label {
		font-size: var(--text-small);
		line-height: 1.5;
		color: var(--color-text-secondary);
	}

	/* Mobile — Figma "Faruq — Homepage mobile" (390) */
	@media (max-width: 47.99rem) {
		.hero {
			padding-block: 48px;
		}

		.hero__main {
			gap: 28px;
		}

		.hero__label-row {
			flex-direction: column;
			align-items: flex-start;
		}

		.hero__support {
			gap: 28px;
		}

		.hero__description {
			flex-basis: 100%;
		}

		.hero__actions {
			width: 100%;
			flex-wrap: nowrap;
			gap: var(--space-2);
		}

		.hero__actions :global(.hero__secondary) {
			display: none;
		}

		.hero__text-link {
			display: inline-flex;
			flex: 1 1 0;
			align-items: center;
			justify-content: center;
			gap: 6px;
			height: 56px;
			font-size: var(--text-small);
			white-space: nowrap;
		}

		.proof {
			grid-template-columns: 1fr;
			gap: 28px;
			margin-top: 48px;
			padding-top: 28px;
		}
	}
</style>
