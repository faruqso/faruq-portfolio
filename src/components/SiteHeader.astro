---
import type { NavItem } from '../lib/types';
import { primaryCta, site } from '../data/site';
import Button from './Button.astro';

type Props = { items: NavItem[]; minimal?: boolean };

const { items, minimal = false } = Astro.props;
---

<header class="site-header">
	<div class="container site-header__inner">
		{
			minimal ? (
				<span class="site-header__brand">
					<slot name="brand" />
					<span class="wordmark wordmark--play" data-wordmark>
						<span class="sr-only">{site.wordmark}</span>
						<span aria-hidden="true">
							{[...site.wordmark].map((char, i) => (
								<span class="wordmark__char" style={`--i: ${i}`}>
									{char === ' ' ? ' ' : char}
								</span>
							))}
						</span>
					</span>
				</span>
			) : (
				<a class="wordmark" href="/" aria-label={`${site.name} — home`}>
					{site.wordmark}
				</a>
			)
		}
		{
			!minimal && (
				<p class="site-header__status">
					<img src="/icons/status-dot.svg" alt="" width="9" height="9" />
					{site.availability}
				</p>
			)
		}
		{!minimal && (
		<nav class="site-header__nav" aria-label="Primary">
			<ul class="site-header__list">
				{
					items.map((item) => (
						<li>
							<a class="site-header__link" href={item.href}>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
			<Button href={primaryCta.href}>{primaryCta.label}</Button>
		</nav>
		)}
	</div>
</header>

<script>
	// Tap / click replays the wave (hover covers mouse users on its own).
	document.querySelectorAll<HTMLElement>('[data-wordmark]').forEach((mark) => {
		const last = mark.querySelector<HTMLElement>('.wordmark__char:last-child');
		mark.addEventListener('click', () => {
			mark.classList.remove('is-hopping');
			void mark.offsetWidth; // restart the animation
			mark.classList.add('is-hopping');
			window.setTimeout(() => mark.classList.remove('is-hopping'), 1000);
		});
		last?.addEventListener('animationend', () => mark.classList.remove('is-hopping'));
	});
</script>

<style>
	.site-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-5);
		padding-block: var(--space-5);
	}

	.site-header__brand {
		display: inline-flex;
		align-items: center;
		gap: var(--space-3);
	}

	/* Landing-page wordmark: letters hop in a wave on hover or tap. */
	.wordmark--play {
		cursor: default;
		user-select: none;
		-webkit-tap-highlight-color: transparent;
	}

	.wordmark__char {
		display: inline-block;
		transition: color var(--duration-fast) var(--ease-out);
	}

	@media (min-width: 48rem) {
		.wordmark--play:hover .wordmark__char {
			animation: hop 520ms var(--ease-out) calc(var(--i) * 32ms) both;
		}
	}

	.wordmark--play.is-hopping .wordmark__char {
		animation: hop 520ms var(--ease-out) calc(var(--i) * 32ms) both;
	}

	@keyframes hop {
		0%,
		100% {
			transform: translateY(0);
		}
		35% {
			transform: translateY(-5px);
			color: var(--color-accent);
		}
		65% {
			transform: translateY(1px);
		}
	}

	.wordmark {
		font-size: var(--text-wordmark);
		letter-spacing: var(--tracking-wordmark);
		line-height: normal;
		color: var(--color-text);
		white-space: nowrap;
	}

	.site-header__status {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: var(--text-small);
		line-height: normal;
		white-space: nowrap;
	}

	.site-header__status img {
		/* 6px dot; SVG includes a 1.5px halo stroke */
		margin: -1.5px;
	}

	.site-header__nav {
		display: flex;
		align-items: center;
		gap: 40px;
	}

	.site-header__list {
		display: flex;
		gap: var(--space-6);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.site-header__link {
		font-size: var(--text-small);
		line-height: normal;
		transition: color var(--duration-fast) var(--ease-out);
	}

	@media (min-width: 48rem) {
		.site-header__link:hover {
			color: var(--color-accent);
		}
	}

	@media (max-width: 60rem) {
		.site-header__status {
			display: none;
		}
	}

	/* Mobile: wordmark + CTA on top, section links spread underneath */
	@media (max-width: 47.99rem) {
		.site-header__inner {
			flex-wrap: wrap;
			gap: 22px 0;
			padding-block: 20px 16px;
		}

		.site-header__nav {
			display: contents;
		}

		.site-header__list {
			order: 3;
			flex-basis: 100%;
			justify-content: space-between;
			gap: 0;
		}

		.site-header__link {
			display: flex;
			align-items: center;
			justify-content: center;
			min-width: 44px;
			height: 44px;
		}
	}

	@media (max-width: 22rem) {
		.site-header__nav :global(.ds-button) {
			min-width: 0;
		}
	}
</style>
