---
/** Quillo landing page — mobile artboard, 1:1 with Figma frame 32:1062 (390 wide). */
import Device from '../app/Device.astro';
import Icon from '../app/Icon.astro';
import Home from '../app/screens/Home.astro';
import Editor from '../app/screens/Editor.astro';
import Connect from '../app/screens/Connect.astro';
import Published from '../app/screens/Published.astro';
import { cms, statusLabel, cmsDetail, faqs, faqsMobile, plans, compare, uses, steps, clients } from '../../../data/quillo-landing';

const p = '/images/case/quillo/photos';
const sparkle = '<path d="M12 2.5c.4 3.9 2.6 6.1 6.5 6.5-3.9.4-6.1 2.6-6.5 6.5-.4-3.9-2.6-6.1-6.5-6.5 3.9-.4 6.1-2.6 6.5-6.5Z" fill="currentColor"/><path d="M19 14.5c.2 1.8 1.2 2.8 3 3-1.8.2-2.8 1.2-3 3-.2-1.8-1.2-2.8-3-3 1.8-.2 2.8-1.2 3-3Z" fill="currentColor"/>';
const feather = '<path d="M20.2 3.8a5.5 5.5 0 0 0-7.8 0L5 11.2V19h7.8l7.4-7.4a5.5 5.5 0 0 0 0-7.8Z"/><path d="M16 8 3 21M17.5 15H9"/>';
const pro = plans[1];
---

<div class="qs qsm" data-art="mobile" style="width:390px">
	<!-- Hero -->
	<section class="m-hero" data-sec="top">
		<div class="m-hero__card">
			<img class="m-bg" src={`${p}/sky.webp`} alt="" width="1152" height="648" />
			<span class="m-hero__shade" aria-hidden="true"></span>
			<header class="m-nav">
				<span class="qs-mark"><i><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={feather} /></i>Quillo</span>
				<button class="qs-circle m-nav__menu" data-menu aria-expanded="false" aria-label="Menu"><Icon name="menu" size={20} stroke={2.4} /></button>
			</header>
			<nav class="m-menu" data-menu-panel>
				<a data-jump="features">Product</a>
				<a data-jump="how">How it works</a>
				<a data-jump="agencies">For agencies</a>
				<a data-jump="pricing">Pricing</a>
				<a data-jump="faq">FAQ</a>
			</nav>
			<div class="m-hero__copy">
				<p class="m-badge"><b>New</b>Beta open for Sanity teams</p>
				<h1 class="m-hero__h">Your website,<br />edited right from<br />your <em>pocket.</em></h1>
				<p class="m-hero__sub">A beautiful native app for your headless CMS, starting with Sanity. Fix a typo, swap a photo or approve a post in seconds.</p>
				<a class="qs-btn qs-btn--white m-wide" data-jump="join" data-tour-id="hero-cta">Join the waitlist<i class="qs-btn__arrow"><Icon name="arrow" size={14} stroke={2.4} /></i></a>
				<a class="qs-btn m-wide m-watch" data-jump="demo">Watch the 60s demo</a>
			</div>
			<div class="m-hero__phone"><Device width={230}><Home /></Device></div>
			<span class="qs-sticker" style="width:66px;height:66px;left:300px;top:528px"><img src={`${p}/icon-quill.webp`} alt="" /></span>
			<p class="m-chip" style="left:8px;top:636px">
				<span class="qs-circle is-ok"><Icon name="check" size={14} stroke={3} /></span>
				<span><strong>Published</strong><em>crumbandco.com · 2.1s</em></span>
			</p>
			<p class="m-chip" style="left:200px;top:800px">
				<span class="qs-circle is-blue"><Icon name="check" size={14} stroke={3} /></span>
				<span><strong>Priya approved</strong><em>Easter pre-orders</em></span>
			</p>
		</div>
	</section>

	<!-- CMS picker -->
	<section class="m-sec" data-sec="cms">
		<div class="qs-head m-head" data-in>
			<span class="qs-eyebrow"><svg width="14" height="14" viewBox="0 0 24 24" set:html={sparkle} />Integrations</span>
			<h2 class="qs-h">Which CMS runs<br /><em>your website?</em></h2>
			<p class="qs-lead">Sanity is live in beta. Contentful and Strapi are next.</p>
		</div>
		<div class="m-tabs" role="tablist" data-in>
			<button role="tab" aria-selected="true" data-filter="all">All</button>
			<button role="tab" aria-selected="false" data-filter="headless">Headless</button>
			<button role="tab" aria-selected="false" data-filter="builder">Builders</button>
			<button role="tab" aria-selected="false" data-filter="commerce">Commerce</button>
		</div>
		<div class="m-cms" data-in>
			<ul class="m-cms__list">
				{
					cms.map((c, i) => (
						<li
							class:list={['m-cmsrow', { 'is-on': i === 0, 'is-extra': i > 3 }]}
							data-cms={c.id}
							data-cat={c.cat}
							data-name={c.name}
							data-detail={cmsDetail[c.tone]}
							aria-pressed={i === 0 ? 'true' : 'false'}
							role="button"
							tabindex="0"
						>
							<span class="qs-logo" style={`background:${c.color};width:40px;height:40px;border-radius:12px;font-size:18px`}>{c.l}</span>
							<p>
								<strong>{c.name}</strong>
								<span>Headless CMS</span>
							</p>
							<span class={`qs-pill qs-pill--nodot qs-pill--${c.tone}`}>{statusLabel[c.tone]}</span>
						</li>
					))
				}
			</ul>
			<p class="m-cms__empty">No commerce platforms yet. Vote for yours.</p>
		</div>
		<button class="m-more" data-more data-in>+ 4 more planned · Vote for yours →</button>
	</section>

	<!-- Demo -->
	<section class="m-sec m-demo" data-sec="demo">
		<div class="qs-head m-head" data-in>
			<span class="qs-eyebrow"><svg width="14" height="14" viewBox="0 0 24 24" set:html={sparkle} />Product demo</span>
			<h2 class="qs-h">See Quillo in<br /><em>60 seconds.</em></h2>
		</div>
		<div class="m-player" data-player data-in>
			<img class="m-bg" src={`${p}/sky.webp`} alt="" loading="lazy" />
			<div class="m-player__ph"><Device width={232}><Editor /></Device></div>
			<span class="m-player__shade" aria-hidden="true"></span>
			<button class="m-play" data-play aria-label="Play the demo preview">
				<span class="m-play__ring" aria-hidden="true"></span>
				<span class="m-play__btn"><Icon name="play" size={26} /></span>
			</button>
			<p class="qs-glass m-chap"><b data-chap-label><em>0:00</em>Connect</b><span>4 chapters · 1:00</span></p>
		</div>
	</section>

	<!-- Features -->
	<section class="m-sec" data-sec="features">
		<div class="qs-head m-head" data-in>
			<span class="qs-eyebrow"><svg width="14" height="14" viewBox="0 0 24 24" set:html={sparkle} />Why Quillo</span>
			<h2 class="qs-h">The little website jobs,<br />finally <em>phone-sized.</em></h2>
			<p class="qs-lead">Typos, prices, photos and approvals, handled from your phone.</p>
		</div>
		<div class="m-tiles">
			<article class="m-tile m-snap" data-in>
				<img class="m-bg" src={`${p}/photographer.webp`} alt="" loading="lazy" />
				<span class="m-snap__shade" aria-hidden="true"></span>
				<p class="qs-glass m-snap__pill"><span class="qs-circle"><Icon name="camera" size={13} /></span>westside-shopfront.heic · 1.9 MB</p>
				<div class="m-tile__copy m-tile__copy--light">
					<h3>Snap. Upload. Live.</h3>
					<p>Shoot on your phone. Quillo resizes it, writes alt text and drops it into your post.</p>
				</div>
			</article>
			<article class="m-tile m-tile--grey" data-in>
				<div class="m-note" data-approve-card>
					<p class="m-note__top">
						<img src={`${p}/avatar-priya.webp`} alt="" width="34" height="34" />
						<span><strong>Priya wants a review</strong><em>Catering for offices · 8m</em></span>
						<span class="qs-pill qs-pill--live" data-approve-pill>In review</span>
					</p>
					<p class="m-note__btns">
						<button class="m-note__yes" data-approve><Icon name="check" size={13} stroke={3} /><span>Approve</span></button>
						<button class="m-note__no" data-toast="Priya gets your comment as a push notification.">Changes</button>
					</p>
				</div>
				<div class="m-tile__copy">
					<h3>Approvals on the go</h3>
					<p>Review, comment and approve from a push notification. Your CMS roles and permissions still apply.</p>
				</div>
			</article>
			<article class="m-tile m-tile--lime" data-in>
				<button class="m-polish" data-polish aria-pressed="false" data-tour-id="polish">
					<s>“our new croisant is realy good”</s>
					<strong>“Meet our new croissant: flaky, buttery and gone by noon.”</strong>
					<span class="m-polish__hint"><Icon name="sparkle" size={12} />Tap to polish</span>
				</button>
				<span class="qs-sticker" style="width:84px;height:84px;right:20px;top:36px"><img src={`${p}/icon-quill.webp`} alt="" /></span>
				<div class="m-tile__copy">
					<h3>AI polish &amp; alt text</h3>
					<p>Fix typos, tighten copy and write alt text for every image, always with a quick review before it goes live.</p>
				</div>
			</article>
			<article class="m-tile m-tile--sky" data-in>
				<span class="qs-sticker" style="width:84px;height:84px;left:24px;top:36px"><img src={`${p}/icon-plane.webp`} alt="" /></span>
				<span class="qs-sticker" style="width:74px;height:74px;left:130px;top:30px;--d:-2s"><img src={`${p}/icon-bell.webp`} alt="" /></span>
				<p class="m-offline"><Icon name="wifi-off" size={13} stroke={2.4} />Draft saved offline · syncs later</p>
				<div class="m-tile__copy">
					<h3>Works offline</h3>
					<p>Edit on the train or in a dead zone. Quillo queues your changes and syncs them the moment you’re back online.</p>
				</div>
			</article>
			<article class="m-tile m-tile--sun" data-in>
				<div class="m-sched">
					<p class="m-sched__t"><span><Icon name="calendar" size={14} /></span>Easter pre-orders</p>
					<p class="m-sched__chips"><span><Icon name="calendar" size={12} />Fri, Apr 3</span><b>9:00 AM</b></p>
					<span class="qs-pill qs-pill--next">Scheduled</span>
				</div>
				<span class="qs-sticker" style="width:76px;height:76px;right:18px;top:56px"><img src={`${p}/icon-bell.webp`} alt="" /></span>
				<div class="m-tile__copy">
					<h3>Schedule it, forget it</h3>
					<p>Line up posts for launch day and Quillo publishes them on time, even if your phone is off.</p>
				</div>
			</article>
		</div>
	</section>

	<!-- How it works -->
	<section class="m-sec" data-sec="how">
		<div class="qs-head m-head" data-in>
			<span class="qs-eyebrow"><svg width="14" height="14" viewBox="0 0 24 24" set:html={sparkle} />How Quillo works</span>
			<h2 class="qs-h">Up and running<br />in <em>three steps.</em></h2>
		</div>
		<div class="m-how" data-in>
			<img class="m-bg" src={`${p}/sky.webp`} alt="" loading="lazy" />
			<div class="m-how__ph m-how__ph--a"><Device width={170}><Connect /></Device></div>
			<div class="m-how__ph m-how__ph--b"><Device width={170}><Editor /></Device></div>
			<span class="qs-sticker" style="width:62px;height:62px;right:12px;top:14px"><img src={`${p}/icon-check.webp`} alt="" /></span>
			<span class="qs-sticker" style="width:64px;height:64px;left:12px;top:238px;--d:-3s"><img src={`${p}/icon-quill.webp`} alt="" /></span>
		</div>
		<ol class="m-steps" data-in>
			{
				steps.map(([t, , d], i) => (
					<li class:list={{ 'is-on': i === 0 }} data-step={i} role="button" tabindex="0">
						<b>{i + 1}</b>
						<p>
							<strong>{t}</strong>
							<span>{d}</span>
						</p>
					</li>
				))
			}
		</ol>
		<div class="m-dev" data-in>
			<span class="m-dev__chip">For developers</span>
			<h3>5-minute setup</h3>
			<pre><span>npm i sanity-plugin-quillo</span>
<span class="c-lime">npx sanity schema deploy</span></pre>
		</div>
	</section>

	<!-- Use cases -->
	<section class="m-sec" data-sec="uses">
		<div class="qs-head m-head" data-in>
			<span class="qs-eyebrow"><svg width="14" height="14" viewBox="0 0 24 24" set:html={sparkle} />Who it’s for</span>
			<h2 class="qs-h">Made for people<br /><em>not at a desk.</em></h2>
		</div>
		<ul class="m-uses" data-in data-swipe>
			{
				uses.map((u) => (
					<li class="m-use">
						<img class="m-bg" src={`${p}/${u.img}`} alt="" loading="lazy" />
						<span class="m-use__shade" aria-hidden="true" />
						<p class="qs-glass m-use__pill">
							<span class:list={['qs-circle', u.tone === 'ok' ? 'is-ok' : 'is-blue']}>
								<Icon name="check" size={11} stroke={3} />
							</span>
							{u.pill}
						</p>
						<div class="qs-glass m-use__card">
							<strong>{u.t}</strong>
							<span>{u.d}</span>
						</div>
					</li>
				))
			}
		</ul>
		<p class="m-dots" aria-hidden="true" data-swipe-dots><i class="is-on"></i><i></i><i></i></p>
	</section>

	<!-- Agencies -->
	<section class="m-agency" data-sec="agencies">
		<div class="m-agency__card">
			<span class="m-agency__glow" aria-hidden="true"></span>
			<div class="m-agency__copy" data-in>
				<span class="qs-eyebrow m-agency__eb"><svg width="14" height="14" viewBox="0 0 24 24" set:html={sparkle} />For agencies</span>
				<h2 class="qs-h">White-label it for<br /><em>every client.</em></h2>
				<p class="m-agency__lead">Every client site gets its own branded editing app.</p>
				<ul class="m-agency__list">
					<li><i><Icon name="palette" size={16} /></i>Your brand, colors and app icon</li>
					<li><i><Icon name="shield" size={16} /></i>Client-safe roles</li>
					<li><i><Icon name="grid" size={16} /></i>One dashboard for every site</li>
				</ul>
				<a class="qs-btn qs-btn--blue m-wide" data-toast="Agency demos open with the beta. Join the waitlist to book one.">Book an agency demo<i class="qs-btn__arrow"><Icon name="arrow" size={14} stroke={2.4} /></i></a>
			</div>
			<div class="m-agency__vis" data-in>
				<img class="m-bg" src={`${p}/agency.webp`} alt="" loading="lazy" />
				<div class="qs-glass m-apps">
					<p><strong>Your client apps</strong><span>12 sites · 38 editors</span></p>
					<ul>
						{
							clients.map((c) => (
								<li>
									<b style={`background:${c.c}`}>{c.l}</b>
									{c.n}
								</li>
							))
						}
					</ul>
				</div>
				<p class="qs-glass m-joined">
					<img src={`${p}/avatar-amara.webp`} alt="" width="26" height="26" />
					<span><strong>Amara joined Crumb &amp; Co.</strong><em>Editor · can publish menu items</em></span>
				</p>
			</div>
		</div>
	</section>

	<!-- Comparison -->
	<section class="m-sec" data-sec="compare">
		<div class="qs-head m-head" data-in>
			<span class="qs-eyebrow"><svg width="14" height="14" viewBox="0 0 24 24" set:html={sparkle} />Compare</span>
			<h2 class="qs-h">Laptop, browser,<br /><em>or Quillo?</em></h2>
		</div>
		<div class="m-table" data-in>
			<div class="m-table__row m-table__row--head"><span></span><b>Laptop</b><b>Browser</b><b class="is-q">Quillo</b></div>
			{
				compare.map((r) => (
					<div class="m-table__row">
						<span>{r.short}</span>
						{r.v.map((v, j) => (
							<i class={`m-mark m-mark--${v}${j === 2 && v === 'y' ? 'q' : ''}`}>
								<Icon name={v === 'y' ? 'check' : v === 'p' ? 'minus' : 'x'} size={12} stroke={3} />
							</i>
						))}
					</div>
				))
			}
		</div>
	</section>

	<!-- Pricing -->
	<section class="m-sec" data-sec="pricing">
		<div class="qs-head m-head" data-in>
			<span class="qs-eyebrow"><svg width="14" height="14" viewBox="0 0 24 24" set:html={sparkle} />Pricing</span>
			<h2 class="qs-h">Simple pricing.<br /><em>Free while you’re small.</em></h2>
		</div>
		<div class="m-ptabs" role="tablist" data-in>
			{plans.map((pl) => <button role="tab" aria-selected={pl.id === 'pro' ? 'true' : 'false'} data-plan-tab={pl.id}>{pl.name}</button>)}
		</div>
		<div class="m-plan" data-plan="pro" data-in data-tour-id="pro">
			<p class="m-plan__name"><span data-p="name">{pro.name}</span><em>Most popular</em></p>
			<p class="m-plan__price"><strong data-p="price">{pro.price}</strong><span data-p="unit">{pro.unit}</span></p>
			<p class="m-plan__desc" data-p="desc">{pro.desc}</p>
			<a class="qs-btn qs-btn--white m-wide" data-p-cta data-jump="join"><span data-p="cta">{pro.cta}</span><i class="qs-btn__arrow"><Icon name="arrow" size={14} stroke={2.4} /></i></a>
			<hr />
			<ul data-p="items">
				{
					pro.items.map((it) => (
						<li>
							<i class="qs-circle">
								<Icon name="check" size={11} stroke={3} />
							</i>
							{it}
						</li>
					))
				}
			</ul>
		</div>
		<script type="application/json" data-plans set:html={JSON.stringify(plans)} />
	</section>

	<!-- FAQ -->
	<section class="m-sec qs-faq" data-sec="faq">
		<div class="qs-head m-head" data-in>
			<span class="qs-eyebrow"><svg width="14" height="14" viewBox="0 0 24 24" set:html={sparkle} />FAQ</span>
			<h2 class="qs-h">Questions,<br /><em>answered.</em></h2>
		</div>
		<div class="m-faq" data-in>
			{
				faqsMobile.map((q, i) => (
					<details open={i === 0} data-faq data-tour-id={i === 1 ? 'faq' : undefined}>
						<summary>
							{q}
							<i class="qs-circle">
								<Icon name="plus" size={14} stroke={2.4} />
							</i>
						</summary>
						<p>{faqs[i][1]}</p>
					</details>
				))
			}
		</div>
	</section>

	<!-- Final CTA -->
	<section class="m-cta" data-sec="join">
		<div class="m-cta__card">
			<img class="m-bg" src={`${p}/sky.webp`} alt="" loading="lazy" />
			<span class="m-cta__shade" aria-hidden="true"></span>
			<h2 class="m-cta__h" data-in>Your website is<br /><em>one tap away.</em></h2>
			<form class="m-join" data-join novalidate data-in>
				<label class="m-join__field">
					<Icon name="mail" size={18} />
					<span class="sr-only">Email</span>
					<input type="email" placeholder="you@yourwebsite.com" data-email autocomplete="off" />
				</label>
				<button class="qs-btn qs-btn--dark m-wide" data-tour-id="join">Join the waitlist<i class="qs-btn__arrow"><Icon name="arrow" size={14} stroke={2.4} /></i></button>
				<p class="m-join__msg" data-join-msg>iOS &amp; Android · Free for 1 site · No credit card</p>
			</form>
			<div class="m-cta__phone"><Device width={232}><Published /></Device></div>
		</div>
	</section>

	<!-- Footer -->
	<footer class="m-foot">
		<span class="qs-mark"><i><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={feather} /></i>Quillo</span>
		<p class="m-foot__tag">The mobile app for every headless CMS.</p>
		<div class="m-foot__cols">
			<p><strong>Product</strong><a data-jump="features">Features</a><a data-jump="pricing">Pricing</a><a>Roadmap</a></p>
			<p><strong>Company</strong><a>About</a><a data-jump="agencies">Agencies</a><a>Privacy</a></p>
		</div>
		<p class="m-foot__copy">© 2026 Quillo. A product concept by Faruq So.</p>
	</footer>
</div>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
	}
	.m-bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: -2;
	}
	.is-ok {
		background: var(--ok);
		color: #fff;
	}
	.is-blue {
		background: var(--b);
		color: #fff;
	}
	.m-wide {
		justify-content: space-between;
		width: 100%;
		height: 54px;
		padding: 0 12px 0 22px;
		font-size: 15px;
	}

	/* Section frame */
	.m-sec {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 32px;
		padding: 72px 16px 0;
	}
	.m-head {
		gap: 16px;
	}
	.m-head :global(.qs-h) {
		font-size: 36px;
		letter-spacing: -1.4px;
	}
	.m-head :global(.qs-lead) {
		font-size: 16px;
	}

	/* Hero */
	.m-hero {
		height: 868px;
		padding: 8px;
	}
	.m-hero__card {
		position: relative;
		height: 852px;
		border-radius: 28px;
		overflow: hidden;
		isolation: isolate;
	}
	.m-hero__shade {
		position: absolute;
