---
/** Quillo landing page — desktop artboard, 1:1 with Figma frame 11:187 (1440 wide). */
import Device from '../app/Device.astro';
import Icon from '../app/Icon.astro';
import Home from '../app/screens/Home.astro';
import Editor from '../app/screens/Editor.astro';
import Media from '../app/screens/Media.astro';
import Connect from '../app/screens/Connect.astro';
import Published from '../app/screens/Published.astro';
import { cms, schemaCode, statusLabel, cmsDetail, faqs, plans, compare, uses, steps, clients, chapters } from '../../../data/quillo-landing';

const p = '/images/case/quillo/photos';
const sparkle = '<path d="M12 2.5c.4 3.9 2.6 6.1 6.5 6.5-3.9.4-6.1 2.6-6.5 6.5-.4-3.9-2.6-6.1-6.5-6.5 3.9-.4 6.1-2.6 6.5-6.5Z" fill="currentColor"/><path d="M19 14.5c.2 1.8 1.2 2.8 3 3-1.8.2-2.8 1.2-3 3-.2-1.8-1.2-2.8-3-3 1.8-.2 2.8-1.2 3-3Z" fill="currentColor"/>';
const feather = '<path d="M20.2 3.8a5.5 5.5 0 0 0-7.8 0L5 11.2V19h7.8l7.4-7.4a5.5 5.5 0 0 0 0-7.8Z"/><path d="M16 8 3 21M17.5 15H9"/>';
const recent = [
	{ img: 'pastries.webp', t: 'Spring menu launch', s: '12m ago', pill: 'In review', tone: 'live' },
	{ img: 'baker.webp', t: 'About our sourdough', s: '2h ago', pill: 'Published', tone: 'ok' },
	{ img: 'sky.webp', t: 'Weekend hours', s: 'Yesterday', pill: 'Draft', tone: 'draft' },
];
---

<div class="qs qsd" data-art="desktop" style="width:1440px">
	<!-- Hero -->
	<section class="d-hero" data-sec="top">
		<div class="d-hero__card">
			<img class="d-hero__bg" src={`${p}/sky-wide.webp`} alt="" width="1536" height="864" />
			<span class="d-hero__shade" aria-hidden="true"></span>
			<header class="d-nav">
				<span class="qs-mark"><i><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={feather} /></i>Quillo</span>
				<nav class="d-nav__links">
					<a data-jump="features">Product</a>
					<a data-jump="how">How it works</a>
					<a data-jump="agencies">For agencies</a>
					<a data-jump="pricing">Pricing</a>
					<a data-jump="faq">FAQ</a>
				</nav>
				<a class="qs-btn qs-btn--dark" data-jump="join">Join the waitlist<i class="qs-btn__arrow"><Icon name="arrow" size={14} stroke={2.4} /></i></a>
			</header>

			<div class="d-hero__copy">
				<p class="d-badge"><b>New</b>Beta now open for Sanity teams · Contentful &amp; Strapi next</p>
				<h1 class="d-hero__h">Your website, edited<br />right from your <em>pocket.</em></h1>
				<p class="d-hero__sub">Quillo turns your headless CMS into a beautiful native app, starting with Sanity. Fix a typo, swap a photo or approve a post in seconds, no laptop needed.</p>
				<div class="d-hero__ctas">
					<a class="qs-btn qs-btn--dark d-hero__cta" data-jump="join" data-tour-id="hero-cta">Join the beta waitlist<i class="qs-btn__arrow"><Icon name="arrow" size={14} stroke={2.4} /></i></a>
					<a class="qs-btn qs-btn--white d-hero__watch" data-jump="demo"><Icon name="play" size={16} />Watch the 60s demo</a>
				</div>
			</div>

			<div class="d-hero__phone"><Device width={317}><Home /></Device></div>

			<div class="d-hero__left">
				<div class="qs-glass d-recent">
					<p class="d-recent__head"><strong>Recent edits</strong><a data-toast="That opens the full edit history in the app.">View all</a></p>
					<ul>
						{
							recent.map((r) => (
								<li>
									<img src={`${p}/${r.img}`} alt="" loading="lazy" />
									<p>
										<strong>{r.t}</strong>
										<span>{r.s}</span>
									</p>
									<span class={`qs-pill qs-pill--${r.tone}`}>{r.pill}</span>
								</li>
							))
						}
					</ul>
				</div>
				<div class="qs-glass d-chip">
					<img src={`${p}/avatar-priya.webp`} alt="" width="40" height="40" />
					<p><strong>Priya approved “Easter pre-orders”</strong><span>Goes live Fri, 9:00 AM</span></p>
				</div>
			</div>

			<div class="d-hero__right">
				<div class="qs-glass d-upload">
					<span class="d-upload__ic"><Icon name="upload" size={18} stroke={2.2} /></span>
					<p><strong>Uploading a photo</strong><span>Straight from your camera roll</span></p>
					<img src={`${p}/new-shot.webp`} alt="" loading="lazy" />
					<i class="d-upload__bar"><b></b></i>
				</div>
				<div class="qs-glass d-chip">
					<span class="qs-circle d-chip__ok"><Icon name="check" size={20} stroke={3} /></span>
					<p><strong>Published to crumbandco.com</strong><span>From Amara’s iPhone · 2.1s</span></p>
				</div>
				<div class="qs-glass d-web">
					<p class="d-web__bar"><i></i><i></i><i></i><span><Icon name="lock" size={10} stroke={2.6} />crumbandco.com/menu</span></p>
					<div class="d-web__body">
						<img src={`${p}/pastries.webp`} alt="" loading="lazy" />
						<p><em>NEW · SPRING</em><strong>Spring menu launch</strong><b>$4.50</b></p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- CMS picker -->
	<section class="d-sec d-cms" data-sec="cms">
		<div class="qs-head" data-in>
			<span class="qs-eyebrow"><svg width="14" height="14" viewBox="0 0 24 24" set:html={sparkle} />Integrations</span>
			<h2 class="qs-h">Which CMS runs<br /><em>your website?</em></h2>
			<p class="qs-lead" style="width:620px">Quillo connects through each CMS’s official API. Sanity is live in beta, and the rest are on the way.</p>
		</div>
		<div class="d-tabs" role="tablist" data-in>
			<button role="tab" aria-selected="true" data-filter="all">All CMSs</button>
			<button role="tab" aria-selected="false" data-filter="headless">Headless</button>
			<button role="tab" aria-selected="false" data-filter="builder">Website builders</button>
			<button role="tab" aria-selected="false" data-filter="commerce">Commerce</button>
		</div>
		<div class="d-cms__wrap" data-in>
			<ul class="d-cms__grid">
				{
					cms.map((c, i) => (
						<li
							class:list={['d-cmscard', { 'is-on': i === 0 }]}
							data-cms={c.id}
							data-cat={c.cat}
							data-name={c.name}
							data-detail={cmsDetail[c.tone]}
							aria-pressed={i === 0 ? 'true' : 'false'}
							role="button"
							tabindex="0"
						>
							<p class="d-cmscard__top">
								<span class="qs-logo" style={`background:${c.color}`}>{c.l}</span>
								<span class={`qs-pill qs-pill--${c.tone}`}>{statusLabel[c.tone]}</span>
							</p>
							<p class="d-cmscard__name">
								<strong>{c.name}</strong>
								<span>{c.kind}</span>
							</p>
							<p class="d-cmscard__foot">
								<span>
									<em>Edit from your phone</em>
									{c.has}
								</span>
								<i class="qs-circle">
									<span class="d-cmscard__bell"><Icon name="bell" size={16} /></span>
									<span class="d-cmscard__go"><Icon name="arrow" size={16} stroke={2.4} /></span>
								</i>
							</p>
						</li>
					))
				}
			</ul>
			<p class="d-cms__empty">No commerce platforms yet. Vote for the one you use.</p>
		</div>
		<p class="d-cms__vote" data-in>Don’t see your CMS? <a data-toast="Thanks! Voting opens with the beta.">Vote for the next integration <Icon name="arrow" size={16} stroke={2.4} /></a></p>
	</section>

	<!-- Demo video -->
	<section class="d-sec d-demo" data-sec="demo">
		<div class="qs-head" data-in>
			<span class="qs-eyebrow"><svg width="14" height="14" viewBox="0 0 24 24" set:html={sparkle} />Product demo</span>
			<h2 class="qs-h">See Quillo in<br /><em>60 seconds.</em></h2>
			<p class="qs-lead">From connecting Sanity to publishing a fresh photo, all on one phone.</p>
		</div>
		<div class="d-player" data-player data-in>
			<img class="d-player__bg" src={`${p}/sky-wide.webp`} alt="" loading="lazy" />
			<div class="d-player__ph d-player__ph--1"><Device width={298}><Home /></Device></div>
			<div class="d-player__ph d-player__ph--3"><Device width={298}><Media /></Device></div>
			<div class="d-player__ph d-player__ph--2"><Device width={278}><Editor /></Device></div>
			<span class="d-player__shade" aria-hidden="true"></span>
			<button class="d-play" data-play aria-label="Play the demo preview">
				<span class="d-play__ring" aria-hidden="true"></span>
				<span class="d-play__btn"><Icon name="play" size={34} /></span>
			</button>
			<div class="qs-glass d-chapters" role="tablist">
				{
					chapters.map(([t, n], i) => (
						<button role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-chapter={i}>
							<b>{t}</b>
							{n}
						</button>
					))
				}
				<span class="d-chapters__end">1:00</span>
			</div>
		</div>
	</section>

	<!-- Features bento -->
	<section class="d-sec d-feat" data-sec="features">
		<div class="qs-head" data-in>
			<span class="qs-eyebrow"><svg width="14" height="14" viewBox="0 0 24 24" set:html={sparkle} />Why Quillo</span>
			<h2 class="qs-h">The little website jobs,<br />finally <em>phone-sized.</em></h2>
			<p class="qs-lead" style="width:620px">Typos, prices, photos and approvals. The small jobs that pile up when the CMS only works on a laptop.</p>
		</div>
		<div class="d-bento">
			<article class="d-tile d-schema" data-in>
				<div class="d-tile__copy">
					<span class="d-chip-sm">Zero setup</span>
					<h3>Reads your content model</h3>
					<p>Quillo looks at your schema and builds native forms for every document type: text, images, references, rich text and custom fields.</p>
				</div>
				<pre class="d-code" set:html={schemaCode} />
				<span class="qs-circle d-schema__arrow"><Icon name="arrow" size={22} stroke={2.4} /></span>
				<div class="qs-glass d-form">
					<p class="d-form__h"><Icon name="sparkle" size={14} />Generated for your phone</p>
					<label><span>Title</span><b>Spring menu launch</b></label>
					<label><span>Price</span><b>$ 4.50</b></label>
					<p class="d-form__row"><span>Featured</span><button class="qs-toggle" role="switch" aria-checked="true" aria-label="Featured" data-switch></button></p>
				</div>
			</article>
			<article class="d-tile d-snap" data-in>
				<img src={`${p}/photographer.webp`} alt="" loading="lazy" />
				<span class="d-snap__shade" aria-hidden="true"></span>
				<p class="qs-glass d-snap__pill"><span class="qs-circle"><Icon name="camera" size={15} /></span>westside-shopfront.heic · 1.9 MB</p>
				<div class="d-tile__copy d-tile__copy--light">
					<h3>Snap. Upload. Live.</h3>
					<p>Shoot on your phone. Quillo resizes it, writes alt text and drops it into your post.</p>
				</div>
			</article>

			<article class="d-tile d-tile--3 d-approve" data-in>
				<div class="d-note" data-approve-card>
					<p class="d-note__top">
						<img src={`${p}/avatar-priya.webp`} alt="" width="36" height="36" />
						<span><strong>Priya wants a review</strong><em>Catering for offices · 8m</em></span>
						<span class="qs-pill qs-pill--live" data-approve-pill>In review</span>
					</p>
					<p class="d-note__btns">
						<button class="d-note__yes" data-approve><Icon name="check" size={14} stroke={3} /><span>Approve</span></button>
						<button class="d-note__no" data-toast="Priya gets your comment as a push notification.">Changes</button>
					</p>
				</div>
				<div class="d-tile__copy d-tile__copy--low">
					<h3>Approvals on the go</h3>
					<p>Review, comment and approve from a push notification. Your CMS roles and permissions still apply.</p>
				</div>
			</article>
			<article class="d-tile d-tile--3 d-polish" data-in>
				<span class="qs-sticker" style="width:111px;height:111px;right:28px;top:36px"><img src={`${p}/icon-quill.webp`} alt="" /></span>
				<button class="d-polish__card" data-polish aria-pressed="false" data-tour-id="polish">
					<s>“our new croisant is realy good”</s>
					<strong>“Meet our new croissant: flaky, buttery and gone by noon.”</strong>
					<span class="d-polish__hint"><Icon name="sparkle" size={12} />Tap to polish</span>
				</button>
				<div class="d-tile__copy d-tile__copy--low">
					<h3>AI polish &amp; alt text</h3>
					<p>Fix typos, tighten copy and write alt text for every image, always with a quick review before it goes live.</p>
				</div>
			</article>
			<article class="d-tile d-tile--3 d-offline" data-in>
				<span class="qs-sticker" style="width:107px;height:107px;left:44px;top:40px"><img src={`${p}/icon-plane.webp`} alt="" /></span>
				<span class="qs-sticker" style="width:95px;height:95px;left:186px;top:62px;--d:-2s"><img src={`${p}/icon-bell.webp`} alt="" /></span>
				<p class="d-offline__pill"><Icon name="wifi-off" size={14} stroke={2.4} />Draft saved offline · syncs later</p>
				<div class="d-tile__copy d-tile__copy--low">
					<h3>Works offline</h3>
					<p>Edit on the train or in a dead zone. Quillo queues your changes and syncs them the moment you’re back online.</p>
				</div>
			</article>

			<article class="d-tile d-sched" data-in>
				<div class="d-sched__card">
					<p class="d-sched__t"><span><Icon name="calendar" size={16} /></span>Easter pre-orders</p>
					<p class="d-sched__chips"><span><Icon name="calendar" size={13} />Fri, Apr 3</span><b><Icon name="cloud" size={13} />9:00 AM</b></p>
					<span class="qs-pill qs-pill--next">Scheduled</span>
				</div>
				<span class="qs-sticker" style="width:100px;height:100px;right:30px;top:66px"><img src={`${p}/icon-bell.webp`} alt="" /></span>
				<div class="d-tile__copy d-tile__copy--low">
					<h3>Schedule it, forget it</h3>
					<p>Line up posts for launch day and Quillo publishes them on time, even if your phone is off.</p>
				</div>
			</article>
			<article class="d-tile d-multi" data-in>
				<div class="d-tile__copy">
					<span class="d-chip-sm">Multi-CMS</span>
					<h3>Every site, every CMS,<br />one app</h3>
					<p>Switch between a Sanity bakery site and a Contentful real-estate site in one tap. One login, one inbox.</p>
				</div>
				<div class="d-sites">
					<p class="d-sites__h">Your sites</p>
					{
						[
							['S', '#f03e2f', 'Crumb & Co. Bakery', 'Sanity'],
							['C', '#2478cc', 'Northwind Realty', 'Contentful'],
							['S', '#4945ff', 'Lumen Studio', 'Strapi'],
						].map(([l, c, n, k], i) => (
							<button class:list={['d-sites__row', { 'is-on': i === 0 }]} data-pick>
								<span class="qs-logo" style={`background:${c};width:36px;height:36px;border-radius:11px;font-size:16px`}>{l}</span>
								<span>
									<strong>{n}</strong>
									<em>{k}</em>
								</span>
								<i class="qs-circle"><Icon name="check" size={12} stroke={3} /></i>
							</button>
						))
					}
				</div>
			</article>
		</div>
	</section>

	<!-- How it works -->
	<section class="d-sec d-how" data-sec="how">
		<div class="d-how__card">
			<div class="d-how__left" data-in>
				<div class="qs-head qs-head--left">
					<span class="qs-eyebrow"><svg width="14" height="14" viewBox="0 0 24 24" set:html={sparkle} />How Quillo works</span>
					<h2 class="qs-h">Up and running<br />in <em>three steps.</em></h2>
				</div>
				<ol class="d-steps">
					{
						steps.map(([t, d], i) => (
							<li class:list={{ 'is-on': i === 0 }} data-step={i} role="button" tabindex="0">
								<b>{i + 1}</b>
								<p>
									<strong>{t}</strong>
									<span>{d}</span>
								</p>
							</li>
						))
					}
				</ol>
				<a class="qs-btn qs-btn--dark" data-jump="join">Join the waitlist<i class="qs-btn__arrow"><Icon name="arrow" size={14} stroke={2.4} /></i></a>
			</div>
			<div class="d-how__vis" data-in>
				<img src={`${p}/sky-wide.webp`} alt="" loading="lazy" />
				<div class="d-how__ph d-how__ph--a" data-step-ph="0"><Device width={281}><Connect /></Device></div>
				<div class="d-how__ph d-how__ph--b" data-step-ph="1"><Device width={281}><Editor /></Device></div>
				<span class="qs-sticker" style="width:97px;height:97px;right:28px;top:26px"><img src={`${p}/icon-check.webp`} alt="" /></span>
				<span class="qs-sticker" style="width:104px;height:104px;left:-14px;bottom:60px;--d:-3s"><img src={`${p}/icon-quill.webp`} alt="" /></span>
			</div>
		</div>
		<div class="d-dev" data-in>
			<div class="d-dev__copy">
				<span class="d-dev__chip">For developers</span>
				<h3>5-minute setup, then hand it off</h3>
				<p>Install the Studio plugin and deploy your schema. Your editors connect by scanning a QR code, with no account setup for you.</p>
			</div>
			<pre class="d-dev__code"><span class="c-mute"># 1. Add the plugin</span>
npm install sanity-plugin-quillo
<span class="c-mute">// sanity.config.ts → plugins: [quillo()]</span>
<span class="c-mute"># 2. Share your content model</span>
<span class="c-lime">npx sanity schema deploy</span></pre>
		</div>
	</section>

	<!-- Use cases -->
	<section class="d-sec d-uses" data-sec="uses">
		<div class="qs-head" data-in>
			<span class="qs-eyebrow"><svg width="14" height="14" viewBox="0 0 24 24" set:html={sparkle} />Who it’s for</span>
			<h2 class="qs-h">Made for people who<br /><em>aren’t sitting at a desk.</em></h2>
			<p class="qs-lead" style="width:620px">Owners, field teams and agencies who keep a website fresh in between everything else.</p>
		</div>
		<ul class="d-uses__grid">
			{
				uses.map((u, i) => (
					<li class="d-use" data-in style={`--i:${i}`}>
						<img src={`${p}/${u.img}`} alt="" loading="lazy" />
						<span class="d-use__shade" aria-hidden="true" />
						<p class="qs-glass d-use__pill">
							<span class:list={['qs-circle', u.tone === 'ok' ? 'is-ok' : 'is-blue']}>
								<Icon name="check" size={12} stroke={3} />
							</span>
							{u.pill}
						</p>
						<div class="qs-glass d-use__card">
							<strong>{u.t}</strong>
							<span>{u.d}</span>
						</div>
					</li>
				))
			}
		</ul>
	</section>

	<!-- For agencies -->
	<section class="d-agency" data-sec="agencies">
		<div class="d-agency__card">
			<span class="d-agency__glow" aria-hidden="true"></span>
			<div class="d-agency__left" data-in>
				<span class="qs-eyebrow d-agency__eb"><svg width="14" height="14" viewBox="0 0 24 24" set:html={sparkle} />For agencies</span>
				<h2 class="qs-h">White-label it for<br /><em>every client.</em></h2>
				<p class="d-agency__lead">Give every client site its own branded editing app. Clients handle the small updates, and your team keeps its time for real projects.</p>
				<ul class="d-agency__list">
					<li><i><Icon name="palette" size={18} /></i>Your brand, colors and app icon</li>
					<li><i><Icon name="shield" size={18} /></i>Client-safe roles: edit only what they should</li>
					<li><i><Icon name="grid" size={18} /></i>Manage every client site from one dashboard</li>
					<li><i><Icon name="users" size={18} /></i>Invite editors by email, no CMS seat needed</li>
				</ul>
				<p class="d-agency__ctas">
					<a class="qs-btn qs-btn--blue" data-toast="Agency demos open with the beta. Join the waitlist to book one.">Book an agency demo<i class="qs-btn__arrow"><Icon name="arrow" size={14} stroke={2.4} /></i></a>
					<a class="qs-btn d-agency__ghost" data-jump="pricing">See pricing</a>
				</p>
			</div>
			<div class="d-agency__vis" data-in>
				<img src={`${p}/agency.webp`} alt="" loading="lazy" />
				<div class="qs-glass d-apps">
					<p><strong>Your client apps</strong><span>12 sites · 38 editors</span></p>
					<ul>
						{
							clients.map((c) => (
								<li>
									<b style={`background:${c.c}`}>{c.l}</b>
									{c.n}
								</li>
							))
						}
					</ul>
				</div>
				<p class="qs-glass d-joined">
					<img src={`${p}/avatar-amara.webp`} alt="" width="34" height="34" />
					<span><strong>Amara joined Crumb &amp; Co.</strong><em>Editor · can publish menu items</em></span>
				</p>
			</div>
		</div>
	</section>

	<!-- Comparison -->
	<section class="d-sec d-cmp" data-sec="compare">
		<div class="qs-head" data-in>
			<span class="qs-eyebrow"><svg width="14" height="14" viewBox="0 0 24 24" set:html={sparkle} />Compare</span>
			<h2 class="qs-h">Laptop, mobile browser,<br /><em>or Quillo?</em></h2>
			<p class="qs-lead" style="width:620px">Your CMS studio is great at a desk. Everywhere else, you need something built for a phone.</p>
		</div>
		<div class="d-table" data-in>
