---
/**
 * Live landing page — the Quillo landing built 1:1 from Figma (desktop 11:187, mobile 32:1062),
 * rendered at true artboard size and scaled to fit a browser or phone frame so the whole first
 * fold is visible. Autoplays a guided tour; any scroll, tap or key hands control to the visitor.
 */
import '../../styles/quillo-site.css';
import SiteDesktop from './landing/SiteDesktop.astro';
import SiteMobile from './landing/SiteMobile.astro';
---

<div class="ld" data-ld data-device="desktop" data-tour="idle">
	<div class="ld__bar">
		<div class="ld__seg" role="radiogroup" aria-label="Preview device">
			<button type="button" role="radio" aria-checked="true" data-device-btn="desktop">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="2" y="4" width="20" height="13" rx="2"></rect><path d="M8 21h8M12 17v4"></path></svg>
				Desktop
			</button>
			<button type="button" role="radio" aria-checked="false" data-device-btn="mobile">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="3"></rect><path d="M11 18h2"></path></svg>
				Mobile
			</button>
			<span class="ld__seg-thumb" aria-hidden="true"></span>
		</div>
		<p class="ld__status" aria-live="polite">
			<span class="ld__dot" aria-hidden="true"></span>
			<span data-tour-label>Autoplay tour</span>
		</p>
		<button type="button" class="ld__tourbtn" data-tour-toggle>
			<svg class="ld__ic-pause" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="4" width="4" height="16" rx="1"></rect><rect x="14" y="4" width="4" height="16" rx="1"></rect></svg>
			<svg class="ld__ic-play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4v16l13-8z"></path></svg>
			<span data-tour-btn-label>Pause tour</span>
		</button>
	</div>

	<div class="ld__stage" data-stage>
		<!-- Desktop: browser window -->
		<div class="ld__frame ld__frame--desktop" data-frame="desktop">
			<div class="ld__chrome" aria-hidden="true">
				<i></i><i></i><i></i>
				<span>
					<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><rect x="4" y="11" width="16" height="10" rx="2.5"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
					Quillo · landing page (concept)
				</span>
			</div>
			<div class="ld__screen">
				<div class="ld__vp" data-vp="desktop" data-art-w="1440" tabindex="0" aria-label="Interactive Quillo landing page, desktop">
					<div class="ld__sizer"><SiteDesktop /></div>
				</div>
				<div class="ld__sb" aria-hidden="true"><span class="ld__thumb"></span></div>
			</div>
		</div>

		<!-- Mobile: phone -->
		<div class="ld__frame ld__frame--mobile" data-frame="mobile">
			<div class="ld__screen">
				<span class="ld__island" aria-hidden="true"></span>
				<div class="ld__vp" data-vp="mobile" data-art-w="390" tabindex="0" aria-label="Interactive Quillo landing page, mobile">
					<div class="ld__sizer"><SiteMobile /></div>
				</div>
				<div class="ld__sb" aria-hidden="true"><span class="ld__thumb"></span></div>
			</div>
		</div>

		<span class="ld__cursor" data-cursor aria-hidden="true">
			<svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3.5 19 11l-6.2 1.6L9.6 19z" fill="#0b1020" stroke="#fff" stroke-width="1.6" stroke-linejoin="round"></path></svg>
		</span>
		<p class="ld__toast" data-ld-toast role="status"></p>
	</div>
</div>

<style>
	.ld {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 20px;
		font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
	}

	/* ---------- Control bar ---------- */
	.ld__bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 10px 16px;
	}
	.ld__seg {
		position: relative;
		display: inline-grid;
		grid-template-columns: 1fr 1fr;
		padding: 4px;
		border-radius: 99px;
		background: rgba(255, 255, 255, 0.6);
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.9);
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
	}
	.ld__seg button {
		position: relative;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		padding: 9px 18px;
		border: 0;
		background: none;
		font: inherit;
		font-size: 14px;
		font-weight: 600;
		color: #5f6780;
		cursor: pointer;
		transition: color 240ms;
	}
	.ld__seg button[aria-checked='true'] {
		color: #fff;
	}
	.ld__seg button:focus-visible,
	.ld__tourbtn:focus-visible {
		outline: 2px solid #2f5bff;
		outline-offset: 2px;
		border-radius: 99px;
	}
	.ld__seg-thumb {
		position: absolute;
		top: 4px;
		bottom: 4px;
		left: 4px;
		width: calc(50% - 4px);
		border-radius: 99px;
		background: #0b1020;
		transition: transform 420ms cubic-bezier(0.23, 1, 0.32, 1);
	}
	[data-device='mobile'] .ld__seg-thumb {
		transform: translateX(100%);
	}
	.ld__status {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin: 0;
		font-size: 13px;
		font-weight: 600;
		color: #2a3045;
	}
	.ld__dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #a3aabd;
	}
	[data-tour='playing'] .ld__dot {
		background: #1fb86a;
		animation: ld-blink 1.6s ease-in-out infinite;
	}
	@keyframes ld-blink {
		50% {
			box-shadow: 0 0 0 5px rgba(31, 184, 106, 0.18);
		}
	}
	.ld__tourbtn {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 8px 14px;
		border: 0;
		border-radius: 99px;
		background: rgba(255, 255, 255, 0.7);
		font: inherit;
		font-size: 13px;
		font-weight: 600;
		color: #0b1020;
		cursor: pointer;
	}
	.ld__ic-play,
	[data-tour='playing'] .ld__ic-pause {
		display: block;
	}
	.ld__ic-pause,
	[data-tour='playing'] .ld__ic-play {
		display: none;
	}

	/* ---------- Stage and frames ---------- */
	.ld__stage {
		position: relative;
		display: flex;
		justify-content: center;
		width: 100%;
	}
	.ld__frame {
		position: relative;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		background: #fff;
	}
	[data-device='desktop'] .ld__frame--mobile,
	[data-device='mobile'] .ld__frame--desktop {
		display: none;
	}
	.ld__frame--desktop {
		/* Whole first fold visible: the viewport keeps the hero's aspect, and the frame never
		   grows taller than the window allows. */
		width: min(100%, 1180px, calc((100svh - 230px) * 1440 / 1026));
		min-width: min(100%, 320px);
		border-radius: 18px;
		box-shadow:
			0 40px 80px -40px rgba(13, 31, 89, 0.45),
			0 0 0 1px rgba(255, 255, 255, 0.7);
	}
	.ld__chrome {
		display: flex;
		align-items: center;
		gap: 6px;
		height: 36px;
		padding: 0 14px;
		background: #f1f4fa;
		border-bottom: 1px solid #e6e9f2;
		flex-shrink: 0;
	}
	.ld__chrome i {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: #dde2ec;
	}
	.ld__chrome i:nth-child(1) {
		background: #ff6159;
	}
	.ld__chrome i:nth-child(2) {
		background: #ffbd2e;
	}
	.ld__chrome i:nth-child(3) {
		background: #28c941;
	}
	.ld__chrome span {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin: 0 auto;
		padding: 4px 14px;
		border-radius: 99px;
		background: #fff;
		font-size: 12px;
		font-weight: 500;
		color: #5f6780;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		max-width: 70%;
	}
	.ld__frame--desktop .ld__screen {
		aspect-ratio: 1440 / 1026;
		min-height: 300px;
	}
	.ld__frame--mobile {
		width: min(100%, 390px, calc((100svh - 200px) * 390 / 844));
		min-width: min(100%, 280px);
		padding: 10px;
		border-radius: 54px;
		background: linear-gradient(145deg, #2a2d33, #0f1114 40%, #1b1e23);
		box-shadow:
			0 40px 80px -36px rgba(13, 31, 89, 0.55),
			inset 0 0 0 1px rgba(255, 255, 255, 0.08);
	}
	.ld__frame--mobile .ld__screen {
		aspect-ratio: 390 / 844;
		min-height: 480px;
		border-radius: 44px;
		overflow: hidden;
		background: #fff;
	}
	.ld__island {
		position: absolute;
		top: 10px;
		left: 50%;
		width: 96px;
		height: 28px;
		margin-left: -48px;
		border-radius: 20px;
		background: #000;
		z-index: 4;
	}
	.ld__screen {
		position: relative;
		flex: 1;
	}
	.ld__vp {
		position: absolute;
		inset: 0;
		overflow-x: hidden;
		overflow-y: auto;
		overscroll-behavior: contain;
		scrollbar-width: none;
		outline: 0;
	}
	.ld__vp::-webkit-scrollbar {
		display: none;
	}
	.ld__sizer {
		position: relative;
		overflow: hidden;
	}

	/* ---------- Overlay scrollbar ---------- */
	.ld__sb {
		position: absolute;
		top: 6px;
		bottom: 6px;
		right: 4px;
		width: 10px;
		z-index: 5;
		opacity: 0;
		transition: opacity 300ms;
	}
	.ld__frame--mobile .ld__sb {
		top: 44px;
		bottom: 30px;
		right: 3px;
	}
	.ld__frame:hover .ld__sb {
		opacity: 0.55;
	}
	.ld__frame.is-scrolling .ld__sb,
	.ld__sb.is-drag,
	.ld__sb:hover {
		opacity: 1;
	}
	.ld__thumb {
		position: absolute;
		top: 0;
		right: 2px;
		width: 6px;
		min-height: 28px;
		border-radius: 3px;
		background: rgba(11, 16, 32, 0.42);
		box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.6);
		cursor: grab;
		transition:
			width 160ms,
			right 160ms,
			background-color 160ms;
		touch-action: none;
	}
	.ld__sb:hover .ld__thumb,
	.ld__sb.is-drag .ld__thumb {
		width: 8px;
		right: 1px;
		background: rgba(11, 16, 32, 0.6);
	}
	.ld__sb.is-drag .ld__thumb {
		cursor: grabbing;
	}

	/* ---------- Tour cursor + toast ---------- */
	.ld__cursor {
		position: absolute;
		left: 0;
		top: 0;
		z-index: 10;
		pointer-events: none;
		opacity: 0;
		transform: translate(var(--cx, 50%), var(--cy, 50%));
		transition:
			transform 900ms cubic-bezier(0.65, 0, 0.35, 1),
			opacity 300ms;
		filter: drop-shadow(0 4px 8px rgba(11, 16, 32, 0.3));
	}
	[data-tour='playing'] .ld__cursor {
		opacity: 1;
	}
	.ld__cursor::after {
		content: '';
		position: absolute;
		left: -12px;
		top: -12px;
		width: 34px;
		height: 34px;
		border-radius: 50%;
		background: rgba(47, 91, 255, 0.35);
		transform: scale(0);
		opacity: 0;
	}
	.ld__cursor.is-click::after {
		animation: ld-click 500ms ease-out;
	}
	@keyframes ld-click {
		from {
			transform: scale(0.3);
			opacity: 1;
		}
		to {
			transform: scale(1.4);
			opacity: 0;
		}
	}
	.ld__toast {
		position: absolute;
		left: 50%;
		bottom: 20px;
		z-index: 11;
		max-width: min(90%, 420px);
		margin: 0;
		padding: 10px 16px;
		border-radius: 14px;
		background: #0b1020;
		color: #fff;
		font-size: 13px;
		font-weight: 500;
		line-height: 1.4;
		text-align: center;
		box-shadow: 0 16px 32px -12px rgba(11, 16, 32, 0.5);
		opacity: 0;
		transform: translate(-50%, 10px);
		pointer-events: none;
		transition:
			opacity 240ms,
			transform 240ms cubic-bezier(0.23, 1, 0.32, 1);
	}
	.ld__toast.is-on {
		opacity: 1;
		transform: translate(-50%, 0);
	}

	@media (max-width: 47.99rem) {
		.ld__frame--mobile {
			width: min(100%, 390px, calc((100svh - 140px) * 390 / 844));
			padding: 8px;
			border-radius: 46px;
		}
		.ld__frame--mobile .ld__screen {
			min-height: 440px;
			border-radius: 38px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.ld__cursor {
			transition: none;
		}
	}
</style>

<script>
	const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
	type Dev = 'desktop' | 'mobile';

	for (const root of document.querySelectorAll<HTMLElement>('[data-ld]')) {
		const $ = <T extends Element = HTMLElement>(s: string, el: ParentNode = root) => el.querySelector<T>(s)!;
		const stage = $('[data-stage]');
		const cursor = $('[data-cursor]');
		const toastEl = $('[data-ld-toast]');
		const tourLabel = $('[data-tour-label]');
		const tourBtnLabel = $('[data-tour-btn-label]');
		const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
		let toastTimer = 0;

		const toast = (text: string) => {
			toastEl.textContent = text;
			toastEl.classList.add('is-on');
			clearTimeout(toastTimer);
			toastTimer = window.setTimeout(() => toastEl.classList.remove('is-on'), 2600);
		};

		/* ---- Each viewport: scale-to-fit, overlay scrollbar, reveals ---- */
		type View = { vp: HTMLElement; art: HTMLElement; sizer: HTMLElement; frame: HTMLElement; k: number; sync: () => void };
		const views = {} as Record<Dev, View>;

		for (const vp of root.querySelectorAll<HTMLElement>('[data-vp]')) {
			const dev = vp.dataset.vp as Dev;
			const artW = Number(vp.dataset.artW);
			const sizer = $('.ld__sizer', vp);
			const art = $('.qs', vp);
			const frame = vp.closest<HTMLElement>('.ld__frame')!;
			const sb = $('.ld__sb', frame);
			const thumb = $('.ld__thumb', sb);
			const view: View = { vp, art, sizer, frame, k: 1, sync: () => {} };
			views[dev] = view;
			let fade = 0;

			const bar = () => {
				const h = sb.clientHeight;
				const ratio = vp.clientHeight / vp.scrollHeight;
				const th = Math.max(28, h * ratio);
				const max = vp.scrollHeight - vp.clientHeight;
				thumb.style.height = `${th}px`;
				thumb.style.transform = `translateY(${max > 0 ? (vp.scrollTop / max) * (h - th) : 0}px)`;
				sb.style.display = ratio >= 1 ? 'none' : '';
			};

			const reveal = () => {
				const vr = vp.getBoundingClientRect();
				for (const el of art.querySelectorAll<HTMLElement>('[data-in]:not(.is-seen)')) {
					const r = el.getBoundingClientRect();
					if (r.top < vr.bottom - vr.height * 0.08 && r.bottom > vr.top) el.classList.add('is-seen');
				}
			};

			const fit = () => {
				const w = vp.clientWidth;
				if (!w) return;
				view.k = w / artW;
				art.style.transform = `scale(${view.k})`;
				sizer.style.height = `${art.offsetHeight * view.k}px`;
				bar();
				reveal();
			};
			view.sync = fit;

			new ResizeObserver(fit).observe(vp);
			new ResizeObserver(fit).observe(art);
			fit();
			addEventListener('resize', fit);
			addEventListener('load', fit);
			art.addEventListener('toggle', fit, true);

			let raf = 0;
			vp.addEventListener(
				'scroll',
				() => {
					cancelAnimationFrame(raf);
					raf = requestAnimationFrame(() => {
						bar();
						reveal();
					});
					frame.classList.add('is-scrolling');
					clearTimeout(fade);
					fade = window.setTimeout(() => frame.classList.remove('is-scrolling'), 900);
				},
				{ passive: true },
			);

			// Drag the thumb, or click the track to page.
			thumb.addEventListener('pointerdown', (e) => {
				e.preventDefault();
				thumb.setPointerCapture(e.pointerId);
				sb.classList.add('is-drag');
				const startY = e.clientY;
				const startTop = vp.scrollTop;
				const span = sb.clientHeight - thumb.offsetHeight;
				const max = vp.scrollHeight - vp.clientHeight;
				const move = (ev: PointerEvent) => {
					vp.scrollTop = startTop + ((ev.clientY - startY) / span) * max;
				};
				const up = () => {
					sb.classList.remove('is-drag');
					thumb.removeEventListener('pointermove', move);
					thumb.removeEventListener('pointerup', up);
					thumb.removeEventListener('pointercancel', up);
				};
				thumb.addEventListener('pointermove', move);
				thumb.addEventListener('pointerup', up);
				thumb.addEventListener('pointercancel', up);
			});
			sb.addEventListener('pointerdown', (e) => {
				if (e.target === thumb) return;
				const r = thumb.getBoundingClientRect();
				vp.scrollBy({ top: (e.clientY < r.top ? -1 : 1) * vp.clientHeight * 0.85, behavior: reduce ? 'auto' : 'smooth' });
			});

			wire(view, dev);
		}

		/* ---- Device switch ---- */
		const current = () => root.dataset.device as Dev;
		const setDevice = (d: Dev) => {
			root.dataset.device = d;
			root.querySelectorAll<HTMLElement>('[data-device-btn]').forEach((b) => b.setAttribute('aria-checked', String(b.dataset.deviceBtn === d)));
			requestAnimationFrame(() => views[d].sync());
		};
		root.querySelectorAll<HTMLElement>('[data-device-btn]').forEach((b) =>
			b.addEventListener('click', () => {
				stopTour(true);
				setDevice(b.dataset.deviceBtn as Dev);
			}),
		);
		if (matchMedia('(max-width: 47.99rem)').matches) setDevice('mobile');

		/* ---- In-site behaviour (delegated per artboard) ---- */
		function scrollToEl(view: View, el: Element, offset = 24) {
			const top = view.vp.scrollTop + el.getBoundingClientRect().top - view.vp.getBoundingClientRect().top - offset * view.k;
			view.vp.scrollTo({ top, behavior: reduce ? 'auto' : 'smooth' });
		}

		function wire(view: View, dev: Dev) {
			const art = view.art;
			const chapterTimer = { id: 0 };
			const checks = art.querySelector<HTMLElement>('[data-join-msg]');
			const checksHTML = checks?.innerHTML ?? '';

			const setChapter = (player: HTMLElement, i: number) => {
				player.dataset.ch = String(i);
				player.querySelectorAll<HTMLElement>('[data-chapter]').forEach((b) => b.setAttribute('aria-selected', String(Number(b.dataset.chapter) === i)));
				const label = player.querySelector<HTMLElement>('[data-chap-label]');
				const names = ['Connect', 'Map your content', 'Edit & snap', 'Approve & publish'];
				const times = ['0:00', '0:12', '0:24', '0:42'];
				if (label) label.innerHTML = `<em>${times[i]}</em>${names[i]}`;
			};

			const play = (player: HTMLElement) => {
				clearInterval(chapterTimer.id);
				player.classList.add('is-playing');
				let i = 0;
				setChapter(player, 0);
				chapterTimer.id = window.setInterval(() => {
					i++;
					if (i > 3) {
						clearInterval(chapterTimer.id);
						player.classList.remove('is-playing');
						setChapter(player, 0);
						return;
					}
					setChapter(player, i);
				}, 2600);
			};

			art.addEventListener('click', (event) => {
				const t = event.target as Element;

				const jump = t.closest<HTMLElement>('[data-jump]');
				if (jump) {
					event.preventDefault();
					const sec = art.querySelector(`[data-sec="${jump.dataset.jump}"]`);
					art.querySelector('.m-hero')?.classList.remove('is-menu');
					if (sec) scrollToEl(view, sec, 0);
				}

				const menu = t.closest<HTMLElement>('[data-menu]');
				if (menu) {
					const hero = art.querySelector('.m-hero')!;
					menu.setAttribute('aria-expanded', String(hero.classList.toggle('is-menu')));
				}

				const msg = t.closest<HTMLElement>('[data-toast]');
				if (msg) toast(msg.dataset.toast!);

				const card = t.closest<HTMLElement>('[data-cms]');
				if (card) {
					art.querySelectorAll('[data-cms]').forEach((c) => {
						c.classList.toggle('is-on', c === card);
						c.setAttribute('aria-pressed', String(c === card));
					});
					toast(`${card.dataset.name} ${card.dataset.detail}`);
				}

				const tab = t.closest<HTMLElement>('[data-filter]');
				if (tab) {
					const f = tab.dataset.filter!;
					art.querySelectorAll('[data-filter]').forEach((b) => b.setAttribute('aria-selected', String(b === tab)));
					let shown = 0;
					art.querySelectorAll<HTMLElement>('[data-cms]').forEach((c) => {
						const on = f === 'all' || c.dataset.cat === f;
						c.hidden = !on;
						if (on) shown++;
					});
					const wrap = art.querySelector<HTMLElement>('.d-cms__wrap, .m-cms')!;
					wrap.classList.toggle('is-empty', shown === 0);
					if (f !== 'all') wrap.classList.add('is-all');
					else if (!wrap.dataset.expanded) wrap.classList.remove('is-all');
				}

				if (t.closest('[data-more]')) {
					const wrap = art.querySelector<HTMLElement>('.m-cms')!;
					wrap.dataset.expanded = '1';
					wrap.classList.add('is-all');
					(t.closest('[data-more]') as HTMLElement).textContent = 'Vote for the next integration →';
				}

				const playBtn = t.closest<HTMLElement>('[data-play]');
				if (playBtn) play(playBtn.closest<HTMLElement>('[data-player]')!);
				const ch = t.closest<HTMLElement>('[data-chapter]');
				if (ch) setChapter(ch.closest<HTMLElement>('[data-player]')!, Number(ch.dataset.chapter));

				const polish = t.closest<HTMLElement>('[data-polish]');
				if (polish) polish.setAttribute('aria-pressed', String(polish.getAttribute('aria-pressed') !== 'true'));

				const approve = t.closest<HTMLElement>('[data-approve]');
				if (approve) {
					const note = approve.closest<HTMLElement>('[data-approve-card]')!;
					const done = note.classList.toggle('is-done');
					approve.querySelector('span')!.textContent = done ? 'Approved' : 'Approve';
					const pill = note.querySelector<HTMLElement>('[data-approve-pill]')!;
					pill.textContent = done ? 'Approved' : 'In review';
					pill.classList.toggle('qs-pill--ok', done);
					pill.classList.toggle('qs-pill--live', !done);
				}

				const sw = t.closest<HTMLElement>('[data-switch]');
				if (sw) sw.setAttribute('aria-checked', String(sw.getAttribute('aria-checked') !== 'true'));

				const pick = t.closest<HTMLElement>('[data-pick]');
				if (pick) pick.parentElement!.querySelectorAll('[data-pick]').forEach((r) => r.classList.toggle('is-on', r === pick));

				const step = t.closest<HTMLElement>('[data-step]');
				if (step) {
					step.parentElement!.querySelectorAll('[data-step]').forEach((s) => s.classList.toggle('is-on', s === step));
					const vis = art.querySelector<HTMLElement>('.d-how__vis, .m-how');
					if (vis) vis.dataset.active = step.dataset.step;
				}

				const pt = t.closest<HTMLElement>('[data-plan-tab]');
				if (pt) {
					const plans = JSON.parse(art.querySelector('[data-plans]')!.textContent!) as { id: string; name: string; price: string; unit: string; desc: string; cta: string; items: string[] }[];
					const pl = plans.find((x) => x.id === pt.dataset.planTab)!;
					art.querySelectorAll('[data-plan-tab]').forEach((b) => b.setAttribute('aria-selected', String(b === pt)));
					const card = art.querySelector<HTMLElement>('[data-plan]')!;
					card.dataset.plan = pl.id;
					(['name', 'price', 'unit', 'desc', 'cta'] as const).forEach((k) => (card.querySelector(`[data-p="${k}"]`)!.textContent = pl[k]));
					const ul = card.querySelector('[data-p="items"]')!;
					const tpl = ul.querySelector('li')!;
					ul.replaceChildren(
						...pl.items.map((it) => {
							const li = tpl.cloneNode(true) as HTMLElement;
							li.lastChild!.textContent = it;
							return li;
						}),
					);
					const cta = card.querySelector<HTMLElement>('[data-p-cta]')!;
					if (pl.id === 'agency') {
						cta.removeAttribute('data-jump');
						cta.dataset.toast = 'Agency demos open with the beta. Join the waitlist to book one.';
					} else {
						cta.dataset.jump = 'join';
						delete cta.dataset.toast;
					}
					card.classList.remove('is-swap');
					void card.offsetWidth;
					card.classList.add('is-swap');
				}
			});

			// Keyboard: role=button cards.
			art.addEventListener('keydown', (e) => {
				const el = (e.target as HTMLElement).closest<HTMLElement>('[role="button"]');
				if (el && (e.key === 'Enter' || e.key === ' ')) {
					e.preventDefault();
					el.click();
				}
			});

			// One FAQ open at a time.
			art.querySelectorAll<HTMLDetailsElement>('[data-faq]').forEach((d) =>
				d.addEventListener('toggle', () => {
					if (d.open) art.querySelectorAll<HTMLDetailsElement>('[data-faq]').forEach((o) => o !== d && (o.open = false));
				}),
			);

			// Swipe dots for the mobile use-case carousel.
			const swipe = art.querySelector<HTMLElement>('[data-swipe]');
			const dots = art.querySelectorAll('[data-swipe-dots] i');
			swipe?.addEventListener(
				'scroll',
				() => {
					const i = Math.round(swipe.scrollLeft / (swipe.scrollWidth / 3));
					dots.forEach((d, j) => d.classList.toggle('is-on', j === Math.min(2, i)));
				},
				{ passive: true },
			);

			// Waitlist demo form: nothing is sent anywhere.
			const form = art.querySelector<HTMLFormElement>('[data-join]')!;
			const email = form.querySelector<HTMLInputElement>('[data-email]')!;
			const msgEl = art.querySelector<HTMLElement>('[data-join-msg]')!;
			form.addEventListener('submit', (event) => {
				event.preventDefault();
				form.classList.remove('is-error', 'is-done');
				void form.offsetWidth;
				if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim())) {
					form.classList.add('is-error');
					msgEl.textContent = 'That doesn’t look like an email address yet.';
					return;
				}
				form.classList.add('is-done');
				msgEl.textContent = 'You’re on the list. (This is a demo, so nothing was sent.)';
			});

			(view as View & { reset?: () => void }).reset = () => {
				email.value = '';
				form.classList.remove('is-done', 'is-error');
				msgEl.innerHTML = checksHTML;
				art.querySelectorAll<HTMLElement>('[data-polish]').forEach((p) => p.setAttribute('aria-pressed', 'false'));
				art.querySelectorAll<HTMLElement>('[data-approve-card].is-done [data-approve]').forEach((b) => b.click());
				const faqs = art.querySelectorAll<HTMLDetailsElement>('[data-faq]');
				faqs.forEach((d, i) => (d.open = i === 0));
				art.querySelector<HTMLElement>('[data-filter="all"]')?.click();
				art.querySelector<HTMLElement>('[data-step="0"]')?.click();
				art.querySelector<HTMLElement>('[data-plan-tab="pro"]')?.click();
				const sanity = art.querySelector<HTMLElement>('[data-cms="sanity"]');
				art.querySelectorAll('[data-cms]').forEach((c) => {
					c.classList.toggle('is-on', c === sanity);
					c.setAttribute('aria-pressed', String(c === sanity));
				});
				art.querySelectorAll<HTMLElement>('[data-player]').forEach((pl) => {
					clearInterval(chapterTimer.id);
					pl.classList.remove('is-playing');
					setChapter(pl, 0);
				});
			};
			void dev;
		}

		/* ---- Autoplay tour ---- */
		let token = 0;
		let playing = false;
		let userTook = false;

		const setTourState = (s: 'playing' | 'paused' | 'idle') => {
			root.dataset.tour = s;
			playing = s === 'playing';
			tourLabel.textContent = s === 'playing' ? 'Autoplay tour' : userTook ? 'You’re in control' : 'Tour paused';
			tourBtnLabel.textContent = s === 'playing' ? 'Pause tour' : 'Play tour';
		};

		const moveCursor = (el: Element) => {
			const s = stage.getBoundingClientRect();
			const r = el.getBoundingClientRect();
			cursor.style.setProperty('--cx', `${r.left - s.left + Math.min(r.width * 0.55, 60)}px`);
			cursor.style.setProperty('--cy', `${r.top - s.top + r.height * 0.55}px`);
		};

		const tour = async () => {
			const my = ++token;
			const ok = () => my === token;
			setTourState('playing');

			const click = async (el: HTMLElement | null, wait = 900) => {
				if (!el || !ok()) return ok();
				moveCursor(el);
				await sleep(wait);
				if (!ok()) return false;
				cursor.classList.remove('is-click');
				void cursor.offsetWidth;
				cursor.classList.add('is-click');
				el.click();
				await sleep(380);
				return ok();
			};
			const hold = async (ms: number) => {
				await sleep(ms);
				return ok();
			};

			while (ok()) {
				const view = views[current()];
				const q = <T extends HTMLElement>(s: string) => view.art.querySelector<T>(s);
				const goto = async (sec: string, ms = 1300) => {
					scrollToEl(view, q(`[data-sec="${sec}"]`)!, 0);
					return hold(ms);
				};
				const mobile = current() === 'mobile';

				view.vp.scrollTo({ top: 0, behavior: 'smooth' });
				if (!(await hold(1200))) return;
				moveCursor(q('[data-tour-id="hero-cta"]')!);
				if (!(await hold(1800))) return;

				if (!(await goto('cms'))) return;
				if (!(await click(q('[data-cms="contentful"]')))) return;
				if (!(await hold(1400))) return;
				if (!(await click(q('[data-filter="builder"]')))) return;
				if (!(await hold(1000))) return;
				if (!(await click(q('[data-filter="all"]')))) return;
				if (!(await click(q('[data-cms="sanity"]')))) return;
				if (!(await hold(1000))) return;

				if (!(await goto('demo'))) return;
				if (!(await click(q('[data-play]')))) return;
				if (!(await hold(4200))) return;

				if (!(await goto('features'))) return;
				const polish = q('[data-tour-id="polish"]')!;
				scrollToEl(view, polish.closest('article')!, mobile ? 24 : 120);
				if (!(await hold(1100))) return;
				if (!(await click(polish))) return;
				if (!(await hold(1300))) return;
				if (!(await click(q('[data-approve]')))) return;
				if (!(await hold(1300))) return;

				if (!(await goto('how'))) return;
				if (mobile) scrollToEl(view, q('.m-steps')!, 260);
				if (!(await click(q('[data-step="1"]'), 1100))) return;
				if (!(await hold(1300))) return;

				if (!(await goto('pricing'))) return;
				if (mobile) {
					if (!(await click(q('[data-plan-tab="agency"]')))) return;
					if (!(await hold(1300))) return;
					if (!(await click(q('[data-plan-tab="pro"]')))) return;
				} else {
					const pro = q('[data-tour-id="pro"]')!;
					moveCursor(pro);
					pro.classList.add('is-hover');
					if (!(await hold(1600))) return;
					pro.classList.remove('is-hover');
				}

				if (!(await goto('faq'))) return;
				if (!(await click(q('[data-tour-id="faq"] summary')))) return;
				if (!(await hold(1800))) return;

				if (!(await goto('join'))) return;
				const email = q<HTMLInputElement>('[data-email]')!;
				moveCursor(email);
				if (!(await hold(900))) return;
				email.value = '';
				for (const ch of 'you@crumbandco.com') {
					if (!ok()) return;
					email.value += ch;
					await sleep(65);
				}
				if (!(await click(q('[data-tour-id="join"]')))) return;
				if (!(await hold(2600))) return;

				(view as View & { reset?: () => void }).reset?.();
				setDevice(mobile ? 'desktop' : 'mobile');
				if (!(await hold(900))) return;
			}
		};

		function stopTour(byUser = false) {
			token++;
			if (byUser) userTook = true;
			root.querySelectorAll('.is-hover').forEach((e) => e.classList.remove('is-hover'));
			setTourState(byUser ? 'paused' : 'idle');
		}

		// Any real interaction inside the stage hands control to the visitor.
		const takeOver = (event: Event) => {
			if (!playing || !event.isTrusted) return;
			stopTour(true);
		};
		['pointerdown', 'wheel', 'touchstart', 'keydown'].forEach((type) => stage.addEventListener(type, takeOver, { passive: true }));

		$('[data-tour-toggle]').addEventListener('click', () => {
			if (playing) stopTour(true);
			else {
				userTook = false;
				tour();
			}
		});

		if (reduce) {
			setTourState('idle');
			tourLabel.textContent = 'Explore it yourself';
		} else {
			new IntersectionObserver(
				([entry]) => {
					if (entry.isIntersecting && !userTook && !playing) tour();
					if (!entry.isIntersecting && playing) stopTour(false);
				},
				{ threshold: 0.45 },
			).observe(stage);
		}
	}
</script>
