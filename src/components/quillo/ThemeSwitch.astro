---
/** White-label — one coded Home, wiped between the Quillo and Northwind Realty themes. */
import Device from './app/Device.astro';
import Home from './app/screens/Home.astro';

type Props = { width?: number };
const { width = 290 } = Astro.props;
---

<div class="theme" data-theme-switch data-theme="quillo">
	<div class="theme__control" role="radiogroup" aria-label="App theme">
		<button type="button" role="radio" aria-checked="true" data-value="quillo">Quillo</button>
		<button type="button" role="radio" aria-checked="false" data-value="northwind">Northwind Realty</button>
		<span class="theme__thumb" aria-hidden="true"></span>
	</div>
	<Device width={width} label="The Quillo home screen, and the same app white-labelled for Northwind Realty">
		<div class="theme__layer"><Home /></div>
		<div class="theme__layer theme__brand"><Home brand="northwind" /></div>
		<span class="theme__seam" aria-hidden="true"></span>
	</Device>
</div>

<style>
	.theme {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-5);
	}

	.theme__layer {
		position: absolute;
		inset: 0;
	}

	.theme__brand {
		clip-path: inset(0 0 0 100%);
		transition: clip-path 800ms cubic-bezier(0.65, 0, 0.35, 1);
	}

	[data-theme='northwind'] .theme__brand {
		clip-path: inset(0 0 0 0);
	}

	/* A light seam rides the wipe edge. */
	.theme__seam {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 100%;
		width: 3px;
		background: linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.95), transparent);
		box-shadow: 0 0 24px 6px rgba(200, 242, 90, 0.55);
		opacity: 0;
		z-index: 50;
		transition:
			left 800ms cubic-bezier(0.65, 0, 0.35, 1),
			opacity 800ms ease;
	}

	[data-theme='northwind'] .theme__seam {
		left: 0;
	}

	.theme.is-moving .theme__seam {
		opacity: 1;
	}

	.theme__control {
		position: relative;
		display: inline-grid;
		grid-template-columns: 1fr 1fr;
		padding: 4px;
		border-radius: 99px;
		background: rgba(255, 255, 255, 0.08);
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14);
	}

	.theme__control button {
		position: relative;
		z-index: 1;
		padding: 9px 18px;
		border: 0;
		background: none;
		font: inherit;
		font-size: var(--text-small);
		color: rgba(255, 255, 255, 0.7);
		cursor: pointer;
		white-space: nowrap;
		transition: color var(--duration-fast) var(--ease-out);
	}

	.theme__control button[aria-checked='true'] {
		color: #181a1b;
	}

	.theme__control button:focus-visible {
		outline: 2px solid #c8f25a;
		outline-offset: 2px;
		border-radius: 99px;
	}

	.theme__thumb {
		position: absolute;
		top: 4px;
		bottom: 4px;
		left: 4px;
		width: calc(50% - 4px);
		border-radius: 99px;
		background: #c8f25a;
		transition: transform 420ms var(--ease-out);
	}

	[data-theme='northwind'] .theme__thumb {
		transform: translateX(100%);
	}
</style>

<script>
	for (const root of document.querySelectorAll<HTMLElement>('[data-theme-switch]')) {
		const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-value]')];
		let auto = 0;
		let touched = false;
		let moving = 0;

		const set = (value: string) => {
			if (root.dataset.theme === value) return;
			root.dataset.theme = value;
			buttons.forEach((b) => b.setAttribute('aria-checked', String(b.dataset.value === value)));
			root.classList.add('is-moving');
			clearTimeout(moving);
			moving = window.setTimeout(() => root.classList.remove('is-moving'), 800);
		};

		buttons.forEach((b) =>
			b.addEventListener('click', () => {
				touched = true;
				clearInterval(auto);
				set(b.dataset.value!);
			}),
		);

		// Demo the re-skin on its own while visible, until someone uses the control.
		if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
			new IntersectionObserver(
				([entry]) => {
					clearInterval(auto);
					if (entry.isIntersecting && !touched) {
						auto = window.setInterval(() => set(root.dataset.theme === 'quillo' ? 'northwind' : 'quillo'), 3200);
					}
				},
				{ threshold: 0.5 },
			).observe(root);
		}
	}
</script>
