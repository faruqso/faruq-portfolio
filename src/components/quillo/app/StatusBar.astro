---
/** iOS status bar. `light` for dark backgrounds. `time={false}` for the lock screen. */
type Props = { light?: boolean; time?: boolean };
const { light = false, time = true } = Astro.props;
---

<div class:list={['qa-status', { 'qa-status--light': light, 'qa-status--notime': !time }]}>
	{time && <span class="qa-status__time">9:41</span>}
	<span class="qa-status__icons">
		<svg width="18" height="12" viewBox="0 0 18 12" aria-hidden="true"
			><rect x="0" y="8" width="3" height="4" rx="1"></rect><rect x="5" y="5.5" width="3" height="6.5" rx="1"></rect><rect x="10" y="3" width="3" height="9" rx="1"></rect><rect x="15" y="0" width="3" height="12" rx="1"></rect></svg
		>
		<svg width="16" height="12" viewBox="0 0 16 12" aria-hidden="true"
			><path d="M8 2.6c2.3 0 4.4.9 6 2.4l1.2-1.3A10.4 10.4 0 0 0 8 .8C5.3.8 2.7 1.8.8 3.7L2 5a8.6 8.6 0 0 1 6-2.4Zm0 3.6c1.3 0 2.5.5 3.4 1.3l1.2-1.3A6.8 6.8 0 0 0 8 4.4c-1.7 0-3.3.6-4.6 1.8l1.2 1.3c.9-.8 2.1-1.3 3.4-1.3ZM8 12l2.2-2.4a3.2 3.2 0 0 0-4.4 0Z"
			></path></svg
		>
		<svg width="27" height="13" viewBox="0 0 27 13" aria-hidden="true"
			><rect x="0.5" y="0.5" width="23" height="12" rx="3.8" fill="none" stroke="currentColor" stroke-opacity=".4"></rect><rect x="2" y="2" width="20" height="9" rx="2.5"></rect><path d="M25 4.5v4c.8-.3 1.3-1.1 1.3-2s-.5-1.7-1.3-2Z" opacity=".45"></path></svg
		>
	</span>
</div>
