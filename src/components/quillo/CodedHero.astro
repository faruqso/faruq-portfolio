---
/**
 * Case-study hero, coded: the Quillo editor on a phone over the sky and hill, with glass
 * cards telling the story (photo uploading → live on the site). Floats gently; tilts with the cursor.
 */
import Device from './app/Device.astro';
import Editor from './app/screens/Editor.astro';
const p = '/images/case/quillo/photos';
---

<div class="ch" data-coded-hero>
	<div class="ch__sky" aria-hidden="true"></div>
	<div class="ch__scene" data-tilt>
		<div class="ch__phone">
			<Device width={300} label="The Quillo editor on a phone, editing the Spring menu launch item">
				<Editor />
			</Device>
		</div>

		<div class="ch-card ch-card--upload" aria-hidden="true">
			<p class="ch-card__row">
				<span class="ch-card__icon">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15V3M7 8l5-5 5 5"></path><path d="M5 15v4a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4"></path></svg>
				</span>
				<span><strong>Photo uploaded</strong><small>Spring menu launch · Sanity</small></span>
			</p>
			<img src={`${p}/pastries.webp`} alt="" width="240" height="120" />
			<span class="ch-card__bar"><i></i></span>
		</div>

		<div class="ch-card ch-card--live" aria-hidden="true">
			<p class="ch-card__url"><i></i><i></i><i></i><span>crumbandco.com/menu</span></p>
			<img src={`${p}/pastries.webp`} alt="" width="280" height="130" />
			<p class="ch-card__foot"><span><em>New · Spring</em><strong>Spring menu launch</strong></span><b>$4.50</b></p>
		</div>

		<div class="ch-card ch-card--toast" aria-hidden="true">
			<span class="ch-card__check">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
			</span>
			<span><strong>Published to crumbandco.com</strong><small>Spring menu launch · Published</small></span>
		</div>
	</div>
</div>

<style>
	.ch {
		position: relative;
		aspect-ratio: 1280 / 760;
		overflow: hidden;
		border-radius: 24px;
		background: linear-gradient(180deg, #1c6be0 0%, #4a9bf5 40%, #9ccbff 100%);
		font-family: 'Plus Jakarta Sans', var(--font-sans);
		color: #0b1020;
		perspective: 1400px;
	}

	.ch__sky {
		position: absolute;
		inset: 0;
		background: url('/images/case/quillo/photos/sky.webp') 50% 100% / cover no-repeat;
		transform: scale(1.06) translateY(var(--sky-y, 0px));
		transition: transform 600ms cubic-bezier(0.23, 1, 0.32, 1);
	}

	.ch__scene {
		position: absolute;
		inset: 0;
		transform-style: preserve-3d;
		transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
		transition: transform 700ms cubic-bezier(0.23, 1, 0.32, 1);
	}

	.ch__phone {
		position: absolute;
		left: 50%;
		top: 8%;
		width: 25%;
		transform: translateX(-50%) translateZ(40px);
		animation: ch-float 7s ease-in-out infinite;
	}

	.ch__phone :global(.qd) {
		width: 100%;
	}

	@keyframes ch-float {
		50% {
			translate: 0 -10px;
		}
	}

	.ch-card {
		position: absolute;
		border-radius: 20px;
		background: rgba(255, 255, 255, 0.88);
		backdrop-filter: blur(14px);
		box-shadow: 0 30px 60px -28px rgba(13, 26, 77, 0.55), inset 0 0 0 1px rgba(255, 255, 255, 0.7);
		transform: translateZ(80px);
	}

	.ch-card small {
		display: block;
		font-size: clamp(9px, 0.9vw, 12px);
		color: #5f6780;
	}

	.ch-card strong {
		display: block;
		font-size: clamp(11px, 1.05vw, 14px);
		font-weight: 600;
	}

	.ch-card--upload {
		left: 9%;
		top: 40%;
		width: 22%;
		padding: 2%;
		animation: ch-float 8s ease-in-out 0.6s infinite;
	}

	.ch-card__row {
		display: flex;
		align-items: center;
		gap: 10px;
		margin: 0 0 10px;
	}

	.ch-card__icon {
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		border-radius: 10px;
		background: #e8edff;
		color: #2f5bff;
		flex-shrink: 0;
	}

	.ch-card img {
		width: 100%;
		height: auto;
		aspect-ratio: 2 / 1;
		object-fit: cover;
		border-radius: 12px;
	}

	.ch-card__bar {
		display: block;
		height: 5px;
		margin-top: 10px;
		border-radius: 99px;
		background: #e6e9f2;
		overflow: hidden;
	}

	.ch-card__bar i {
		display: block;
		height: 100%;
		width: 100%;
		border-radius: inherit;
		background: linear-gradient(90deg, #5aaeff, #2f5bff);
		transform-origin: 0 50%;
		animation: ch-upload 4.5s cubic-bezier(0.65, 0, 0.35, 1) infinite;
	}

	@keyframes ch-upload {
		0% {
			transform: scaleX(0);
		}
		55%,
		100% {
			transform: scaleX(1);
		}
	}

	.ch-card--live {
		right: 9%;
		top: 44%;
		width: 24%;
		overflow: hidden;
		animation: ch-float 9s ease-in-out 1.2s infinite;
	}

	.ch-card__url {
		display: flex;
		align-items: center;
		gap: 5px;
		margin: 0;
		padding: 10px 12px;
	}

	.ch-card__url i {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #ff5f57;
	}

	.ch-card__url i:nth-child(2) {
		background: #febc2e;
	}

	.ch-card__url i:nth-child(3) {
		background: #28c840;
	}

	.ch-card__url span {
		flex: 1;
		margin-left: 6px;
		padding: 4px 10px;
		border-radius: 99px;
		background: #fff;
		font-size: clamp(9px, 0.85vw, 11px);
		color: #5f6780;
		text-align: center;
	}

	.ch-card--live img {
		border-radius: 0;
	}

	.ch-card__foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin: 0;
		padding: 10px 14px 12px;
	}

	.ch-card__foot em {
		display: block;
		font-style: normal;
		font-size: clamp(8px, 0.75vw, 10px);
		font-weight: 600;
		text-transform: uppercase;
		color: #2f5bff;
	}

	.ch-card__foot b {
		font-size: clamp(12px, 1.2vw, 17px);
	}

	.ch-card--toast {
		right: 9%;
		top: calc(44% + 31%);
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 10px 16px 10px 10px;
		border-radius: 99px;
		animation: ch-toast 4.5s cubic-bezier(0.34, 1.56, 0.64, 1) infinite;
	}

	@keyframes ch-toast {
		0%,
		55% {
			opacity: 0;
			transform: translateZ(80px) translateY(12px) scale(0.94);
		}
		65%,
		92% {
			opacity: 1;
			transform: translateZ(80px);
		}
		100% {
			opacity: 0;
			transform: translateZ(80px);
		}
	}

	.ch-card__check {
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		border-radius: 50%;
		background: #1fb86a;
		color: #fff;
		flex-shrink: 0;
	}

	@media (max-width: 47.99rem) {
		.ch {
			aspect-ratio: 4 / 5;
			border-radius: 16px;
		}

		.ch__phone {
			width: 56%;
			top: 5%;
		}

		.ch-card strong {
			font-size: 11px;
		}

		.ch-card small {
			font-size: 9px;
		}

		.ch-card--upload {
			left: 3%;
			top: 52%;
			width: 40%;
			padding: 8px;
			border-radius: 14px;
		}

		.ch-card__row {
			gap: 6px;
			margin-bottom: 6px;
		}

		.ch-card__icon {
			width: 24px;
			height: 24px;
			border-radius: 7px;
		}

		.ch-card__icon svg {
			width: 13px;
			height: 13px;
		}

		.ch-card--upload img {
			border-radius: 8px;
		}

		.ch-card--live {
			display: none;
		}

		.ch-card--toast {
			right: 3%;
			top: 80%;
			gap: 6px;
			padding: 6px 10px 6px 6px;
		}

		.ch-card__check {
			width: 22px;
			height: 22px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.ch__phone,
		.ch-card,
		.ch-card__bar i {
			animation: none;
		}

		.ch-card--toast {
			opacity: 1;
		}
	}
</style>

<script>
	for (const root of document.querySelectorAll<HTMLElement>('[data-coded-hero]')) {
		const scene = root.querySelector<HTMLElement>('[data-tilt]')!;
		if (matchMedia('(prefers-reduced-motion: reduce)').matches || !matchMedia('(hover: hover)').matches) continue;
		root.addEventListener('pointermove', (e) => {
			const r = root.getBoundingClientRect();
			const x = (e.clientX - r.left) / r.width - 0.5;
			const y = (e.clientY - r.top) / r.height - 0.5;
			scene.style.setProperty('--ry', `${x * 6}deg`);
			scene.style.setProperty('--rx', `${-y * 4}deg`);
			root.style.setProperty('--sky-y', `${y * -8}px`);
		});
		root.addEventListener('pointerleave', () => {
			scene.style.setProperty('--ry', '0deg');
			scene.style.setProperty('--rx', '0deg');
			root.style.setProperty('--sky-y', '0px');
		});
	}
</script>
