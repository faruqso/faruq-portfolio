<script>
	const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

	// Section reveals: fade up once when 15% visible.
	const reveals = document.querySelectorAll<HTMLElement>('[data-reveal]');
	if (reduce) {
		reveals.forEach((el) => el.classList.add('is-in'));
	} else {
		const io = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					entry.target.classList.add('is-in');
					io.unobserve(entry.target);
				}
			},
			{ threshold: 0.15, rootMargin: '0px 0px -40px 0px' },
		);
		reveals.forEach((el) => io.observe(el));
		// Fallback for fast jumps (anchors, scrollbar drags) that skip past an element entirely.
		let pending = [...reveals];
		const sweep = () => {
			pending = pending.filter((el) => {
				if (el.getBoundingClientRect().top < innerHeight) {
					el.classList.add('is-in');
					io.unobserve(el);
					return false;
				}
				return true;
			});
			if (!pending.length) removeEventListener('scroll', onSweep);
		};
		let sweepQueued = false;
		const onSweep = () => {
			if (sweepQueued) return;
			sweepQueued = true;
			setTimeout(() => {
				sweepQueued = false;
				sweep();
			}, 150);
		};
		addEventListener('scroll', onSweep, { passive: true });
	}

	// Scroll-linked motion: hero settle, pinned flow row, landing page auto-scroll.
	const hero = document.querySelector<HTMLElement>('[data-hero]');
	const pin = document.querySelector<HTMLElement>('[data-pin]');
	const items = [...document.querySelectorAll<HTMLElement>('[data-flow-item]')];
	const bar = document.querySelector<HTMLElement>('[data-pin-bar]');
	const pinned = matchMedia('(min-width: 64rem) and (prefers-reduced-motion: no-preference)');

	const clamp = (v: number) => Math.min(1, Math.max(0, v));
	let ticking = false;

	const update = () => {
		ticking = false;
		const vh = innerHeight;

		if (hero) {
			const r = hero.getBoundingClientRect();
			const p = clamp(1 - r.top / vh);
			hero.style.setProperty('--hero-scale', String(1.06 - 0.06 * p));
		}

		if (pin && pinned.matches) {
			const r = pin.getBoundingClientRect();
			const p = clamp(-r.top / (r.height - vh * 0.85));
			const active = Math.min(items.length - 1, Math.floor(p * items.length));
			items.forEach((el, i) => el.classList.toggle('is-active', i === active));
			bar?.style.setProperty('--p', String(p));
		} else {
			items.forEach((el) => el.classList.remove('is-active'));
		}
	};

	if (!reduce) {
		addEventListener(
			'scroll',
			() => {
				if (!ticking) {
					ticking = true;
					requestAnimationFrame(update);
				}
			},
			{ passive: true },
		);
		addEventListener('resize', update);
		update();
	}
</script>
